<div{{ attributes }}>
    <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="text-sm font-semibold text-content-primary-light dark:text-content-primary-dark">Saison</p>
            <p class="mt-1 text-xs text-content-secondary-light dark:text-content-secondary-dark">
                Le tableau s'adapte automatiquement a l'annee selectionnee.
            </p>
        </div>
        <label class="inline-flex items-center gap-3">
            <span class="text-sm font-medium text-content-primary-light dark:text-content-primary-dark">Annee</span>
            <select data-model="year" class="min-w-28 rounded-lg border border-base-light bg-base-light/40 px-3 py-2 text-sm text-content-primary-light dark:border-base-dark dark:bg-base-dark/40 dark:text-content-primary-dark">
                {% for availableYear in this.availableYears %}
                    <option value="{{ availableYear }}" {% if availableYear == this.year %}selected{% endif %}>
                        {{ availableYear }}
                    </option>
                {% endfor %}
            </select>
        </label>
    </div>

    {% set standings = this.standings|default([]) %}
    {% if standings is not empty %}
        <div class="overflow-hidden rounded-xl border border-base-light/70 bg-surface-light shadow-sm dark:border-base-dark/70 dark:bg-surface-dark">
            <div class="overflow-x-auto">
            <table class="min-w-full table-auto text-xs text-left md:text-sm text-content-primary-light dark:text-content-primary-dark">
                <thead class="bg-base-light/50 text-xs uppercase text-content-primary-light dark:bg-base-dark/50 dark:text-content-primary-dark">
                <tr>
                    <th scope="col" class="w-14 px-3 py-3">#</th>
                    <th scope="col" class="w-20 px-3 py-3 text-center">Evol.</th>
                    <th scope="col" class="px-3 py-3">Participant</th>
                    <th scope="col" class="px-3 py-3 text-center whitespace-nowrap">
                        <span class="block md:hidden">Part.</span>
                        <span class="hidden md:block">Participations</span>
                    </th>
                    <th scope="col" class="px-3 py-3 text-center whitespace-nowrap">
                        <span class="block md:hidden">Plaq.</span>
                        <span class="hidden md:block">{{ 'meeting.points'|trans }}</span>
                    </th>
                    <th scope="col" class="px-3 py-3 text-center whitespace-nowrap">
                        <span class="block md:hidden">{{ 'meeting.avgHits_min'|trans }}</span>
                        <span class="hidden md:block">{{ 'meeting.avgHits'|trans }}</span>
                    </th>
                </tr>
                </thead>
                <tbody>
                {% set prevMeetingPosition = null %}
                {% for row in standings %}
                    {% set previousRank = row.previousRank|default(null) %}
                    {% set change = (previousRank is not null and previousRank > 0) ? (previousRank - row.rank) : null %}
                    <tr class="border-b border-base-light/70 dark:border-base-dark/70
                            {% if row.rank == 1 %} bg-warning/20 shadow-[inset_3px_0_0_var(--color-warning)]
                    {% elseif row.rank == 2 %} bg-[#8E9298]/20 shadow-[inset_3px_0_0_#8E9298]
                    {% elseif row.rank == 3 %} bg-[#9A6543]/20 shadow-[inset_3px_0_0_#9A6543]
                            {% else %} bg-transparent {% endif %}">
                        <td class="px-3 py-4 font-medium whitespace-nowrap">
                            {% if row.rank != prevMeetingPosition %}
                                {{ row.rank }}
                            {% endif %}
                            {% set prevMeetingPosition = row.rank %}
                        </td>
                        <td class="p-3 text-center">
                            {% if change is null %}
                                <span>-</span>
                            {% elseif change > 0 %}
                                <span class="font-medium text-green-900">↗ +{{ change }}</span>
                            {% elseif change < 0 %}
                                <span class="font-medium text-red-900">↘ {{ change }}</span>
                            {% else %}
                                <span>→ =</span>
                            {% endif %}
                        </td>
                        <td class="px-3 py-4">
                            <div class="flex items-center gap-2">
                                <span class="min-w-0 break-words">
                                    {{ row.firstName }} {{ row.lastName|first }}.
                                </span>
                            </div>
                        </td>
                        <td class="px-3 py-4 text-center">{{ row.meetingCount|default('—') }}</td>
                        <td class="px-3 py-4 text-center">{{ row.totalScore|default('—') }}</td>
                        <td class="px-3 py-4 text-center">{{ row.averageHits|default('—') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
            <div class="border-t border-base-light/70 px-3 py-3 text-xs text-content-secondary-light dark:border-base-dark/70 dark:text-content-secondary-dark md:px-4">
                <p class="mt-0 md:hidden">Plaq. : nombre de plaquettes abattues. Part. : nombre de participations.</p>
            </div>
        </div>
    {% else %}
        <div class="p-4 text-sm text-content-primary-light bg-surface-light border border-surface-light rounded-lg dark:bg-surface-dark dark:text-content-primary-dark dark:border-surface-dark">
            Aucun classement disponible pour le moment.
        </div>
    {% endif %}
</div>
