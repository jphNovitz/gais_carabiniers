{% extends 'base.html.twig' %}

{% block title %}Ajouter des participants{% endblock %}

{% block body %}
    <div class="container-fluid p-4">
        <div class="mb-4 flex items-center justify-between">
            <h3 class="text-xl font-semibold text-content-primary-light dark:text-content-primary-dark">
                Ajouter des participants
            </h3>
            <a href="{{ path('admin_meeting_show', {id: meeting.id}) }}"
               class="inline-flex items-center rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">
                {{ 'button.back_list'|trans }}
            </a>
        </div>

        <div class="shadow-md sm:rounded-lg bg-base-light dark:bg-base-dark p-6">
            {{ form_errors(form) }}

            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                {{ form_widget(form) }}

                <div class="mt-6 flex items-center gap-3">
                    <button type="submit"
                            class="text-white bg-content-secondary/90 hover:bg-content-secondary/90 focus:outline-none focus:ring-4 focus:ring-content-secondary/30 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-content-secondary/70 dark:hover:bg-content-secondary/80 dark:focus:ring-content-secondary/90">
                        {{ 'button.add'|trans }}
                    </button>
                    <a href="{{ path('admin_meeting_show', {id: meeting.id}) }}"
                       class="inline-flex items-center rounded-lg border border-gray-300 px-5 py-2.5 text-sm text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">
                        {{ 'button.back_list'|trans }}
                    </a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

