{% extends 'base.html.twig' %}

{% block body %}


    <section class="max-w-6xl mx-auto p-8 space-y-12">
        <div>
            <h2 class="text-2xl font-bold mb-6">2025</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <h3 class="font-semibold text-xl mb-1">Classement final </h3>
            </div>
        </div>
        {% for year, grouped in groupedMeetings %}
            <div>
                <h2 class="text-2xl font-bold mb-6">{{ year }}</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    {% for type, meetings in grouped %}
                        <div>
                            <h3 class="font-semibold text-xl mb-1">{{ ('meeting.type.'~type) |trans }} </h3>
                            {% for meeting in meetings %}
                                <div class="block p-4 bg-surface-light dark:bg-surface-dark rounded-xl shadow hover:bg-base-300 transition">
                                    <a href="{{ path('meeting_show', {'id': meeting.id}) }}"> {{ meeting.title }} </a>
                                    <div class="grid grid-cols-2 gap-2">
                                        <div class="text-sm">{{ meeting.date|format_datetime('long', 'none') }}</div>
                                        <div class="text-sm">{{ meeting.participantCount }} participants</div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <p>Pas de compétition</p>
        {% endfor %}
    </section>

{% endblock %}