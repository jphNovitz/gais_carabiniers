{% extends 'base.html.twig' %}
{# {% block title %}{% trans %}club.about {% endtrans %}{% endblock %} #}
{% block title %}Histoire des Gais Carabiniers - Club de Tir à Bernissart depuis 1947{% endblock %}
{% block seo_content %}club tir Bernissart, Gais Carabiniers, tir sportif, Critérium Daniel Manfroid, URSTB-F, histoire club tir{% endblock %}
{% block seo_description %}Découvrez l'histoire des Gais Carabiniers, club de tir emblématique de Bernissart depuis 1947. Infrastructures modernes, événements comme le Critérium Daniel Manfroid et ambiance conviviale vous attendent.{% endblock %}
{% block og_title %}Histoire des Gais Carabiniers - Club de Tir à Bernissart depuis 1947{% endblock %}
{% block og_description %}Découvrez l'histoire des Gais Carabiniers, club de tir emblématique de Bernissart depuis 1947. Rejoignez une communauté passionnée dans un cadre sécurisé.{% endblock %}
{% block og_image %}https://gc-bernissart.be/images/carousel/gais-carabiniers-slider_01.jpg{% endblock %}
{% block og_url %}https://gc-bernissart.be/notre-histoire{% endblock %}
{% block twitter_title %}Histoire des Gais Carabiniers - Club de Tir à Bernissart depuis 1947{% endblock %}
{% block twitter_description %}Découvrez l'histoire des Gais Carabiniers, club de tir emblématique de Bernissart depuis 1947. Rejoignez une communauté passionnée dans un cadre sécurisé.{% endblock %}
{% block twitter_image %}https://gc-bernissart.be/images/carousel/gais-carabiniers-slider_01.jpg{% endblock %}

{% block nav_secondary %}
    {# ── Breadcrumb ── #}
    <nav aria-label="Fil d'Ariane" class="max-w-5xl mx-auto px-6 pt-6 pb-2">
        <ol class="flex items-center gap-2 text-sm font-medium text-content-primary-light/60 dark:text-content-primary-dark/60">
            <li>
                <a href="{{ path('app_home') }}" class="hover:text-secondary transition-colors duration-200">Accueil</a>
            </li>
            <li>
                <span class="text-content-primary-light/30 dark:text-content-primary-dark/30 select-none"
                      aria-hidden="true">›</span>
                <a href="{{ path('app_category_show', {'slug': 'competitions-tir-sportif'}) }}"
                   class="hover:text-secondary transition-colors duration-200 truncate">
                    Competitions de tir sportif
                </a>
            </li>
            <li>
                <span class="text-content-primary-light/30 dark:text-content-primary-dark/30 select-none"
                      aria-hidden="true">›</span>
                <a href="{{ path('app_agenda') }}" class="hover:text-secondary transition-colors duration-200 truncate">
                    Agenda
                </a>
            </li>
            <li aria-current="page"
                class="min-w-0 flex items-center gap-2 text-content-primary-light dark:text-content-primary-dark font-semibold">
                <span class="text-content-primary-light/30 dark:text-content-primary-dark/30 select-none"
                      aria-hidden="true">›</span>
                    {{ facebookEvent.title }}
            </li>
        </ol>
    </nav>
{% endblock %}

{% block body %}
    <section
            class="bg-surface-light/90 dark:bg-surface-dark/40 dark:text-content-primary-dark/70 py-8 px-4 sm:px-16 lg:py-16 lg:px-48 space-y-16 antialiased">
        {#        <section class="bg-surface-light/90 dark:bg-surface-dark/40"> #}
        <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
            <div class="max-w-screen-lg text-content-primary-light-50 sm:text-lg dark:text-content-primary-dark/40">
                <h1> {{ facebookEvent.title }}
                    <span class="pl-12 font-thin text-sm">({{ facebookEvent.date |format_date(locale='fr', pattern='dd MMMM yyyy') }})</span>
                </h1>
                <div class="my-8 space-y-4 font-medium">{{ facebookEvent.description | raw }}</div>

                {% if facebookEvent.facebookLink %}
                    <a href="{{ facebookEvent.facebookLink }}" target="_blank"
                       class="inline-flex items-center font-medium text-primary-600 hover:text-primary-800 dark:text-primary-500 dark:hover:text-primary-700">
                        {{ 'text.learn.more' |trans }}
                        <svg class="ml-1 w-6 h-6" fill="currentColor" viewBox="0 0 20 20"
                             xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd"
                                  d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                  clip-rule="evenodd"></path>
                        </svg>
                    </a>
                {% else %}
                    <a href="{{ 'mailto:' ~ globalInfos.email }}?subject={{ facebookEvent.title|url_encode }}"
                       class="inline-flex items-center font-medium text-primary-600 hover:text-primary-800 dark:text-primary-500 dark:hover:text-primary-700">
                        {{ 'text.contact.us' |trans }}
                        <svg class="ml-1 w-6 h-6" fill="currentColor" viewBox="0 0 20 20"
                             xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd"
                                  d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                  clip-rule="evenodd"></path>
                        </svg>
                    </a>
                {% endif %}
            </div>
        </div>
        {#        </section> #}

    </section>
{% endblock %}

