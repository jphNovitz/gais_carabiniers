{% extends '_layout/page_detail.html.twig' %}

{% macro standing_table(title, rows, markSupported) %}
    {% if rows is not empty %}
        <h2 class="mb-6 mt-8 text-3xl font-black uppercase tracking-normal text-base-content">
            {{ title }}
        </h2>

        <div class="overflow-hidden rounded-box bg-base-100 shadow-[0_1px_3px_rgba(0,0,0,0.06),0_8px_28px_rgba(0,0,0,0.07)]">
            <div class="grid grid-cols-[48px_1fr_82px] items-center gap-2 border-b border-base-300 bg-base-100 px-4 py-3 text-[10px] font-bold uppercase tracking-[0.12em] text-neutral md:grid-cols-[64px_1fr_120px] md:px-6">
                <span>{{ 'meeting.rank'|trans }}</span>
                <span>{{ 'meeting.participant'|trans }}</span>
                <span class="text-right">{{ 'meeting.points'|trans }}</span>
            </div>

            {% set prevPosition = null %}
            {% for row in rows %}
                {% set line = row.line %}
                {% set isRepeatedRank = row.rank == prevPosition %}
                <div class="grid grid-cols-[48px_1fr_82px] items-center gap-2 border-b border-base-200 px-4 py-3 last:border-b-0 md:grid-cols-[64px_1fr_120px] md:px-6
                    {% if row.rank == 1 %} bg-warning/20 shadow-[inset_3px_0_0_var(--color-warning)]
                    {% elseif row.rank == 2 %} bg-[#8E9298]/20 shadow-[inset_3px_0_0_#8E9298]
                    {% elseif row.rank == 3 %} bg-[#9A6543]/20 shadow-[inset_3px_0_0_#9A6543]
                    {% endif %}">
                    <div class="flex items-center">
                        {% if not isRepeatedRank %}
                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-black leading-none
                                {% if row.rank == 1 %} border-2 border-[#B88E10] bg-warning text-warning-content
                                {% elseif row.rank == 2 %} border-2 border-[#767A80] bg-[#8E9298] text-white
                                {% elseif row.rank == 3 %} border-2 border-[#7E5235] bg-[#9A6543] text-white
                                {% else %} bg-base-200 text-neutral {% endif %}">
                                {{ row.rank }}
                            </span>
                        {% endif %}
                        {% set prevPosition = row.rank %}
                    </div>
                    <span class="min-w-0 truncate text-sm font-semibold text-base-content md:text-[15px]">
                        {{ line.participant.firstName }} {{ line.participant.lastName|first }}.{% if markSupported and line.usesSupport %} *{% endif %}
                    </span>
                    <span class="text-right text-2xl font-black leading-none text-base-content md:text-[26px]">
                        {{ line.score }}
                    </span>
                </div>
            {% endfor %}
        </div>

        {% if markSupported %}
            <p class="mt-3 text-xs tracking-wide text-neutral">* Tir réalisé avec appui</p>
        {% endif %}
    {% endif %}
{% endmacro %}

{% block page_breadcrumb %}
    <ol class="flex flex-wrap items-center gap-2 text-sm text-base-content/65">
        <li>
            <a href="{{ path('app_home') }}" class="transition-colors hover:text-primary">Accueil</a>
        </li>
        <li class="text-base-content/30" aria-hidden="true">›</li>
        <li>
            <a href="{{ path('app_category_show', {'slug': 'competitions-tir-sportif'}) }}" class="transition-colors hover:text-primary">
                Compétitions de tir sportif
            </a>
        </li>
        <li class="text-base-content/30" aria-hidden="true">›</li>
        <li>
            <a href="{{ path('app_meeting_index') }}" class="transition-colors hover:text-primary">
                Résultats des tirs aux plaquettes
            </a>
        </li>
        <li class="text-base-content/30" aria-hidden="true">›</li>
        <li aria-current="page" class="font-semibold tracking-[0.08em] text-base-content/95">{{ meeting.label }}</li>
    </ol>
{% endblock %}

{% block page_header_top %}
    <div class="mb-4 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.22em] text-primary">
        <span class="h-2 w-2 rounded-full bg-primary"></span>
        Résultats du tir
    </div>
{% endblock %}

{% block page_title %}{{ meeting.label }}{% endblock %}

{% block page_seo_description %}
    Résultats du {{ meeting.label }} du {{ meeting.date|format_datetime('long', 'none', locale='fr') }}, catégorie {{ currentCategoryTitle|lower }}.
{% endblock %}

{% block page_meta %}
    <div class="flex flex-wrap items-center gap-3 text-sm text-base-content/65">
        <time datetime="{{ meeting.date|date('Y-m-d') }}">{{ meeting.date|format_datetime('long', 'none') }}</time>
        <span class="h-1 w-1 rounded-full bg-primary/70"></span>
        <span>{{ currentCategoryTitle }}</span>
    </div>
{% endblock %}

{% block page_content %}
    {% import _self as standingMacros %}

    {% if standingRows is not empty %}
        {{ standingMacros.standing_table(currentCategoryTitle, standingRows, false) }}
    {% else %}
        <p class="not-prose rounded-box bg-base-200 p-6 text-base-content">{{ emptyCategoryMessage }}</p>
    {% endif %}
{% endblock %}
