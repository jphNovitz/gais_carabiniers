{% extends 'base.html.twig' %}

{% block title %}Saisie du tir{% endblock %}

{% block body %}
  <div class="container mx-auto p-4">
    <h1 class="text-2xl font-bold mb-4">Saisie du tir</h1>

    <div class="mb-4 p-3 border rounded bg-gray-50">
      <p>
        Rencontre n° {{ meeting.id }}{% if meeting.label is defined %} - {{ meeting.label }}{% endif %}
      </p>
      <p>
        Tireur (position {{ participant.position }}):
        {% if participant.shooter is defined and participant.shooter %}
          {{ participant.shooter }}
        {% else %}
          Inconnu
        {% endif %}
      </p>
    </div>

    {{ form_start(form) }}
      {{ form_errors(form) }}
      <div class="mb-4">
        {{ form_widget(form) }}
      </div>
      <button type="submit" class="btn btn-primary">Valider le tir</button>
    {{ form_end(form) }}

    <div class="mt-4">
      <a class="text-blue-600 underline" href="{{ path('meeting_show', {id: meeting.id}) }}">Retour à la rencontre</a>
    </div>
  </div>
{% endblock %}

