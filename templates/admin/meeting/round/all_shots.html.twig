{% extends 'base.html.twig' %}

{% block title %}Saisie des tirs{% endblock %}

{% block body %}
    <div class="container mx-auto p-4">
        <twig:Title:H1
                class="text-2xl font-bold mb-4">{% if meeting.label is defined %}{{ meeting.label }}{% endif %}</twig:Title:H1>
        <twig:Title:H2>Volée {{ round.number }}</twig:Title:H2>

        {{ form_start(form) }}
        {{ form_errors(form) }}

        <div class="mt-6 overflow-x-auto">
            <table class="min-w-full text-left text-sm border-collapse border border-gray-200 dark:border-gray-700">
                <thead class="border-b font-medium">
                <tr>
                    <th class="px-4 py-2">Position</th>
                    <th class="px-4 py-2">Participant</th>
                    <th class="px-4 py-2">Score</th>
                    <th class="px-4 py-2">Score</th>
                </tr>
                </thead>
                <tbody>
                {% for roundShotForm in form.roundShots %}
                    {% set roundShot = roundShotForm.vars.data %}
                    <tr class="odd:bg-content-primary-light/10 even:bg-content-primary-dark/10 dark:odd:bg-content-primary-dark/20 dark:even:bg-content-primary-light/20 border-b border-2 ">
                        <td class="px-4 py-2">
                            <div class="flex items-center justify-center">
                                {{ roundShot.meetingParticipant.position }}
                            </div>
                        </td>
                        <td class="px-4 py-2">
                            {% if roundShot.meetingParticipant.shooter is defined and roundShot.meetingParticipant.shooter %}
                                {{ roundShot.meetingParticipant.shooter.firstName }} {{ roundShot.meetingParticipant.shooter.lastName }}
                            {% else %}
                                Inconnu
                            {% endif %}
                        </td>
                        <td class="w-24 py-2">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <input
                                        type="checkbox"
                                        id="{{ roundShotForm.leftHit.vars.id }}"
                                        name="{{ roundShotForm.leftHit.vars.full_name }}"
                                        value="{{ roundShotForm.leftHit.vars.value }}"
                                        {% if roundShotForm.leftHit.vars.checked %}checked{% endif %}
                                        class="w-6 h-6 -ml-1 rounded text-blue-600 bg-gray-100 border-gray-300 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600"
                                />

                                {% do roundShotForm.leftHit.setRendered %}
                                {{ form_widget(roundShotForm.leftTarget) }}
                            </div>
                        </td>
                        <td class="w-24 py-2">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <input
                                        type="checkbox"
                                        id="{{ roundShotForm.leftHit.vars.id }}"
                                        name="{{ roundShotForm.leftHit.vars.full_name }}"
                                        value="{{ roundShotForm.rightHit.vars.value }}"
                                        {% if roundShotForm.leftHit.vars.checked %}checked{% endif %}
                                        class="w-6 h-6 rounded text-blue-600 bg-gray-100 border-gray-300 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600"
                                />
                                {% do roundShotForm.rightHit.setRendered %}
                                {{ form_widget(roundShotForm.rightTarget) }}
                            </div>
                        </td>
                        {#                        <td class="px-4 py-2"> #}
                        {#                            {{ form_widget(roundShotForm.score, { attr: { class: 'w-20' } }) }} #}
                        {#                            {{ form_errors(roundShotForm.score) }} #}
                        {#                        </td> #}
                    </tr>
                    {#                    <tr> #}
                    {#                        <td class="bg-base-dark dark:bg-base-light  px-4 py-2" colspan="3"> #}
                    {#                            #}{#                            {{ form_label(roundShotForm.targets, { attr: { class: 'text-content-primary-dark dark:text-content-primary-light' } }) }} #}
                    {#                            #}{#                            {{ form_widget(roundShotForm.targets, { attr: { class: 'w-full flex justify-between text-content-primary-dark dark:text-content-primary-light' } }) }} #}
                    {#                            <div class="w-full flex justify-between overflow-x-scroll"> #}
                    {#                            {% for targetField in roundShotForm.targets %} #}
                    {#                                {{ form_row(targetField, { #}
                    {#                                    row_attr: { class: ' ' }, #}
                    {#                                    attr: { class: 'inline-block ' }, #}
                    {#                                    label_attr: { class: 'text-content-primary-dark dark:text-content-primary-light'} #}
                    {#                                }) }} #}
                    {#                            {% endfor %} #}
                    {#                            </div> #}
                    {#                        {{ form_errors(roundShotForm.targets) }} #}
                    {#                        </td> #}
                    {#                    </tr> #}
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-6">
            <button type="submit"
                    class="text-white bg-content-secondary/90 hover:bg-content-secondary/90 focus:outline-none focus:ring-4 focus:ring-content-secondary/30 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-content-secondary/70 dark:hover:bg-content-secondary/80 dark:focus:ring-content-secondary/90">
                Enregistrer
            </button>
        </div>
        {{ form_end(form) }}

        <div class="mt-4">
            <a class="text-blue-600 underline" href="{{ path('meeting_show', {id: meeting.id}) }}">Retour à la
                rencontre</a>
        </div>
    </div>
{% endblock %}