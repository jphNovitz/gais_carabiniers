{% set route = app.request.attributes.get('_route') %}
{% set baseClass = 'gc-header__link' %}
{% set activeClass = 'gc-header__link--active' %}
{% set clubName = globalInfos and globalInfos.name ? globalInfos.name : 'Club' %}

<header class="gc-header">
    <nav class="gc-header__bar">
        <div class="gc-header__inner">
            <a href="{{ path('app_home') }}" class="gc-header__brand" aria-label="{{ clubName }}">
                {% if globalInfos and globalInfos.logoName %}
                    <img src="/images/{{ globalInfos.logoName }}" class="gc-header__logo" alt="{{ clubName }}"/>
                {% endif %}
                <span class="gc-header__brand-name">{{ clubName }}</span>
            </a>

            <div class="gc-header__actions">
                <button data-collapse-toggle="mobile-menu-2" type="button"
                        class="gc-header__menu-toggle"
                        aria-controls="mobile-menu-2" aria-expanded="false">
                    <span class="sr-only">{% trans %}button.open_main_menu {% endtrans %}</span>
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd"
                              d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
                              clip-rule="evenodd"></path>
                    </svg>
                </button>
            </div>

            <div id="mobile-menu-2" class="gc-header__menu hidden lg:block">
                <ul class="gc-header__nav">
                    <li>
                        <a href="{{ path('app_home') }}"
                           class="{{ baseClass }} {{ route == 'app_home' ? activeClass : '' }}"
                           aria-current="{{ route == 'app_home' ? 'page' : 'false' }}">
                            {% trans %}nav.home{% endtrans %}
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('app_category_show', {'slug': 'stand-tir-hainaut'}) }}"
                           class="{{ baseClass }} {{ (route == 'app_category_show' and app.request.get('slug') == 'stand-tir-hainaut') ? activeClass : '' }}"
                           aria-current="{{ (route == 'app_category_show' and app.request.get('slug') == 'stand-tir-hainaut') ? 'page' : 'false' }}">
                            {% trans %}nav.about{% endtrans %}
                        </a>
                    </li>

                    <li class="gc-header__dropdown-wrap">
                        <button id="dropdown-standings" data-dropdown-toggle="dropdown-standings-menu"
                                class="{{ baseClass }} gc-header__dropdown-trigger">
                            {% trans %}nav.competitions{% endtrans %}
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>

                        <div id="dropdown-standings-menu" class="gc-header__dropdown z-10 hidden">
                            <ul class="gc-header__dropdown-list">
                                {% set isPresentation = route == 'app_category_show' and app.request.attributes.get('slug') == 'competitions-tir-sportif' %}
                                <li>
                                    <a href="{{ path('app_category_show', {'slug': 'competitions-tir-sportif'}) }}"
                                       class="gc-header__dropdown-link {{ isPresentation ? 'gc-header__dropdown-link--active' : '' }}"
                                       aria-current="{{ isPresentation ? 'page' : 'false' }}">
                                        {{ 'nav.presentation'|trans }}
                                    </a>
                                </li>

                                {% set isAgenda = route == 'app_agenda' %}
                                <li>
                                    <a href="{{ path('app_agenda') }}"
                                       class="gc-header__dropdown-link {{ isAgenda ? 'gc-header__dropdown-link--active' : '' }}"
                                       aria-current="{{ isAgenda ? 'page' : 'false' }}">
                                        {{ 'nav.agenda'|trans }}
                                    </a>
                                </li>

                                {% set isStandardStanding = route in ['meeting_standing', 'meeting_standing_category'] and app.request.attributes.get('category') != 'appuye' %}
                                <li>
                                    <a href="{{ path('meeting_standing_category', {'category': 'standard'}) }}"
                                       class="gc-header__dropdown-link {{ isStandardStanding ? 'gc-header__dropdown-link--active' : '' }}"
                                       aria-current="{{ isStandardStanding ? 'page' : 'false' }}">
                                        {{ 'nav.standings.standard'|trans }}
                                    </a>
                                </li>

                                {% set isSupportedStanding = route == 'meeting_standing_category' and app.request.attributes.get('category') == 'appuye' %}
                                <li>
                                    <a href="{{ path('meeting_standing_category', {'category': 'appuye'}) }}"
                                       class="gc-header__dropdown-link {{ isSupportedStanding ? 'gc-header__dropdown-link--active' : '' }}"
                                       aria-current="{{ isSupportedStanding ? 'page' : 'false' }}">
                                        {{ 'nav.standings.supported'|trans }}
                                    </a>
                                </li>

                                {% set isMeetingIndex = route == 'app_meeting_index' %}
                                <li>
                                    <a href="{{ path('app_meeting_index') }}"
                                       class="gc-header__dropdown-link {{ isMeetingIndex ? 'gc-header__dropdown-link--active' : '' }}"
                                       aria-current="{{ isMeetingIndex ? 'page' : 'false' }}">
                                        {{ 'nav.standings.other'|trans }}
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <li>
                        <a href="{{ path('app_faq') }}"
                           class="{{ baseClass }} {{ route == 'app_faq' ? activeClass : '' }}"
                           aria-current="{{ route == 'app_faq' ? 'page' : 'false' }}">
                            {% trans %}nav.faq{% endtrans %}
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('app_contact') }}"
                           class="{{ baseClass }} {{ route == 'app_contact' ? activeClass : '' }}"
                           aria-current="{{ route == 'app_contact' ? 'page' : 'false' }}">
                            {% trans %}nav.contact{% endtrans %}
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
