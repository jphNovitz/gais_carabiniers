{% extends 'base.html.twig' %}


{% block nav_secondary %}
    {# ── Breadcrumb ── #}
    <nav class="max-w-5xl mx-auto px-6 pt-6 pb-2">
        <ol class="w-full flex flex-col md:flex-row items-start md:items-center gap-2 text-xs md:text-sm font-medium text-content-primary-light/60 dark:text-content-primary-dark/60">
            <li>
                <a href="{{ path('app_home') }}"
                   class="hover:text-secondary transition-colors duration-200">
                    Accueil
                </a>
            </li>
            <li>
                <span class="text-content-primary-light/30 dark:text-content-primary-dark/30 select-none"
                      aria-hidden="true">›</span>
                <a href="{{ path('app_category_show', {'slug': 'competitions-tir-sportif'}) }}" class="hover:text-secondary transition-colors duration-200 truncate">
                    Competitions de tir sportif
                </a>
            </li>
            <li class="truncate">
                <span class="text-content-primary-light/30 dark:text-content-primary-dark/30 select-none">›</span>
                <a href="{{ path('app_meeting_index') }}" class="hover:text-secondary transition-colors duration-200">Résultats des tirs aux plaquettes</a>
            </li>
            <li class="text-content-primary-light dark:text-content-primary-dark font-semibold truncate">
                <span class="text-content-primary-light/30 dark:text-content-primary-dark/30 select-none">›</span>
                {{ meeting.label }}
            </li>
        </ol>
    </nav>
{% endblock %}

{% block body %}
<section class="min-h-screen bg-surface-light dark:bg-surface-dark {# p-2 md:p-6 lg:p-12 #}mx-auto p-8 space-y-12">

    <h1>Classement du <br class="md:hidden"/>{{ meeting.label }}</h1>
    <div>
        Le {{ meeting.date|format_datetime('long', 'none') }}

    </div>
    <div class="py-12">
        {% if standing is defined and standing|length > 0 %}
            <div class="relative overflow-x-auto shadow-md sm:rounded-lg p-4 md:p-8">
                <table class="w-full bg-surface-light dark:bg-surface-dark text-xs md:text-base text-left">
                    <thead class="text-xs uppercase bg-base-light/50 dark:bg-base-dark/50">
                    <tr>
                        <th scope="col" class="p-4 text-content-primary-light dark:text-content-primary-dark">
                            {{ 'meeting.rank' |trans }}
                        </th>
                        <th scope="col" class="p-4 text-content-primary-light dark:text-content-primary-dark">
                            {{ 'meeting.participant' |trans }}
                        </th>
                        <th scope="col" class="p-4 py-3 text-content-primary-light dark:text-content-primary-dark">
                            {{ 'meeting.points' |trans }}
                        </th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set prevPosition = null %}
                    {% for line in standing %}
                        <tr class="border-b dark:border-surface-dark">
                            <td class="px-6 py-4 text-content-primary-light dark:text-content-primary-dark w-24">
                                {% if line.meetingPosition != prevPosition %}
                                    {{ line.meetingPosition }}
                                {% endif %}
                                {% set prevPosition = line.meetingPosition %}
                            </td>
                            <td class="px-6 py-4 text-content-primary-light dark:text-content-primary-dark">
                                {{ line.participant.firstName }} {{ line.participant.lastName|first }}.
                                {% if line.participant.usesSupport %}* {% endif %}
                            </td>
                            <td class="px-6 py-4 text-content-primary-light dark:text-content-primary-dark">
                                {{ line.score }}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                <p>(*) Tir appuyé</p>
            </div>
        {% else %}
            <p class="text-content-primary-light dark:text-content-primary-dark">Aucun participant n'a encore été
                ajouté.</p>
        {% endif %}
    </div>
    </section>{% endblock %}