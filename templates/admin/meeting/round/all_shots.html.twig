{% set lastHitTargets = form.vars.last_hit_targets %}

{% extends '@EasyAdmin/page/content.html.twig' %}

{% block title %}Saisie des tirs{% endblock %}

{% block content %}

    <div class="d-flex flex-column gap-3">
        <div class="w-100 d-flex justify-content-between align-items-center mb-4">
            <h1 class="title h3">{{ meeting.label }} - Passe {{ round.number }}</h1>
            <a href="{{ ea_url()
                .setController('App\\Controller\\Admin\\Meeting\\MeetingCrudController')
                .setAction('edit')
                .setEntityId(meeting.id)
                .generateUrl() }}"
               class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Retour
            </a>
        </div>

        <section class="w-100">
            {{ form_start(form) }}
            {{ form_errors(form) }}

            <div class="table-responsive mt-3" {{ stimulus_controller('toggle_target', {
                lastLeft: lastHitTargets.left,
                lastRight: lastHitTargets.right
            }) }}>
                <table class="table table-sm table-hover table-bordered align-middle">
                    <thead class="table-light">
                    <tr>
                        <th class="text-uppercase small text-center" style="width: 1.5rem">P</th>
                        <th class="text-uppercase small text-start">Tireur</th>
                        <th class="text-uppercase small text-center" style="width: 4rem">Score</th>
                        <th class="text-uppercase small text-center" style="width: 4rem">Score</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for roundShotForm in form.roundShots %}
                        {% set roundShot = roundShotForm.vars.data %}
                        <tr>
                            <td class="d-md-fs-6">
                                {{ roundShot.meetingParticipant.position }}
                            </td>
                            <td class="d-md-fs-6 fw-bold">
                                {% if roundShot.meetingParticipant.shooter is defined and roundShot.meetingParticipant.shooter %}
                                    {{ roundShot.meetingParticipant.shooter.firstName }}
                                    <br class="d-inline-block d-md-none"/> {{ roundShot.meetingParticipant.shooter.lastName }}
                                {% else %}
                                    Inconnu
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <div class="d-flex flex-column align-items-center gap-2">
                                    <input
                                            type="checkbox"
                                            id="{{ roundShotForm.leftHit.vars.id }}"
                                            name="{{ roundShotForm.leftHit.vars.full_name }}"
                                            value="{{ roundShotForm.leftHit.vars.value }}"
                                            data-index="{{ loop.index0 }}"
                                            {% if roundShotForm.leftHit.vars.checked %}checked{% endif %}
                                            class="form-check-input fs-5"
                                            {{ stimulus_target('toggle-target', 'leftHit') }}
                                            {{ stimulus_action('toggle-target', 'toggleLeft') }}
                                    />
                                    {% do roundShotForm.leftHit.setRendered %}
                                    {{ form_widget(roundShotForm.leftTarget, {
                                        attr: {
                                            'disabled': 'disabled',
                                            'data-toggle-target-target': 'leftTarget',
                                            'class': 'form-control form-control-sm text-center'
                                        }
                                    }) }}
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="d-flex flex-column align-items-center gap-2">
                                    <input
                                            type="checkbox"
                                            id="{{ roundShotForm.rightHit.vars.id }}"
                                            name="{{ roundShotForm.rightHit.vars.full_name }}"
                                            value="{{ roundShotForm.rightHit.vars.value }}"
                                            data-index="{{ loop.index0 }}"
                                            {% if roundShotForm.rightHit.vars.checked %}checked{% endif %}
                                            class="form-check-input fs-5"
                                            {{ stimulus_target('toggle-target', 'rightHit') }}
                                            {{ stimulus_action('toggle-target', 'toggleRight') }}
                                    />
                                    {% do roundShotForm.rightHit.setRendered %}
                                    {{ form_widget(roundShotForm.rightTarget, {
                                        attr: {
                                            'disabled': 'disabled',
                                            'data-toggle-target-target': 'rightTarget',
                                            'class': 'form-control form-control-sm text-center'
                                        }
                                    }) }}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="my-12 text-right">
               <input type="submit" value="{{ 'button.submit'|trans }}" class="btn btn-primary" />
            </div>
            {{ form_end(form) }}
        </section>
    </div>

{% endblock %}

