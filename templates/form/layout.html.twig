{% use '@TalesFromADevFlowbite/form/default.html.twig' %}
{#{% extends 'form_div_layout.html.twig' %}#}
{%- block form_row -%}
    {%- set row_attr = row_attr|merge({'class': (row_attr.class|default('mb-8'))|trim}) -%}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~"_help"}} -%}
    {%- endif -%}
    <div{% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        {{- form_label(form) -}}
        {{- form_widget(form, widget_attr) -}}
        {{- form_errors(form) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock form_row -%}

{%- block checkbox_widget -%}
    {%- set attr_class = attr_class|default(block('class_input_checkbox')) -%}
    {%- set attr = attr|merge({'class': (attr_class ~ ' ' ~ attr.class|default(''))|trim}) -%}
    {{- form_label(form, null, { widget: parent() }) -}}
{%- endblock checkbox_widget -%}

{% form_theme roundShotForm.leftHit 'form_div_layout.html.twig' %}
{% form_theme roundShotForm.rightHit 'form_div_layout.html.twig' %}
