{% set meeting = this.meeting %}
{% set participants = this.participants %}

<div{{ attributes }}>
    {% if participants is defined and participants|length > 0 %}
        <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
            <table class="w-full text-sm text-left">
                <thead class="text-xs uppercase bg-surface-light dark:bg-surface-dark">
                <tr>
                    <th scope="col" class="px-6 py-3 text-content-primary-light dark:text-content-primary-dark">
                        Position
                    </th>
                    <th scope="col" class="px-6 py-3 text-content-primary-light dark:text-content-primary-dark">
                        Participant
                    </th>
                    <th scope="col" class="px-6 py-3 text-content-primary-light dark:text-content-primary-dark">
                        Présent
                    </th>
                </tr>
                </thead>
                <tbody>
                {% for p in participants %}
                    <tr class="bg-base-light border-b dark:bg-base-dark dark:border-surface-dark hover:bg-surface-light dark:hover:bg-surface-dark">
                        <td class="px-6 py-4 text-content-primary-light dark:text-content-primary-dark w-32">
                            {{ p.position }}
                            <button
                                    type="button"
                                    data-action="live#action"
                                    data-live-id-param="{{ p.id }}"
                                    data-live-action-param="moveUp"
                            >
                                    ↑
                                </button>

                                <button
                                        data-action="live#action"
                                        data-live-action-param="moveDown"
                                        data-live-id-param="{{ p.id }}"
                                >
                                    ↓
                                </button>
                        </td>
                        <td class="px-6 py-4 text-content-primary-light dark:text-content-primary-dark">
                            {{ p.firstName }} {{ p.lastName }}
                        </td>
                        <td class="px-6 py-4 text-content-primary-light dark:text-content-primary-dark">
                            {% if p.present %}
                                <span class="inline-block px-2 py-0.5 rounded bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300">Oui</span>
                            {% else %}
                                <span class="inline-block px-2 py-0.5 rounded bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300">Non</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="text-content-primary-light dark:text-content-primary-dark">
            Aucun participant n'a encore été ajouté.
        </p>
    {% endif %}
</div>
