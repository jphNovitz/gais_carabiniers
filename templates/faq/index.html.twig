{% extends '_layout/page_detail.html.twig' %}

{% block title %}FAQ club de tir à Bernissart : tarifs, âge et initiation{% endblock %}
{% block seo_description %}Tarifs, âge minimum, première visite, matériel et adhésion : retrouvez les réponses aux questions fréquentes sur notre club de tir à Bernissart.{% endblock %}
{% block og_title %}FAQ club de tir à Bernissart : tarifs, âge et initiation{% endblock %}
{% block og_description %}Tarifs, âge minimum, première visite, matériel et adhésion : retrouvez les réponses aux questions fréquentes sur notre club de tir à Bernissart.{% endblock %}
{% block og_image %}https://gc-bernissart.be/images/gc_bernissart_faq_image.webp{% endblock %}
{% block og_url %}https://gc-bernissart.be/faq{% endblock %}
{% block twitter_title %}FAQ club de tir à Bernissart : tarifs, âge et initiation{% endblock %}
{% block twitter_description %}Tarifs, âge minimum, première visite, matériel et adhésion : retrouvez les réponses aux questions fréquentes sur notre club de tir à Bernissart.{% endblock %}
{% block twitter_image %}https://gc-bernissart.be/images/gc_bernissart_faq_image.webp{% endblock %}
{% block page_breadcrumb %}
    <ol class="flex flex-wrap items-center gap-2 text-sm">
        <li>
            <a href="{{ path('app_home') }}" class="">Accueil</a>
        </li>
        <li class="" aria-hidden="true">›</li>
        <li aria-current="page" class="font-semibold tracking-[0.08em]">
            FAQ
        </li>
    </ol>
{% endblock %}

{% block page_title %}Questions fréquentes sur notre club de tir à Bernissart{% endblock %}

{% block page_summary %}
    Vous souhaitez découvrir le tir sportif ou rejoindre les Gais Carabiniers de Bernissart ?
    Retrouvez ici les réponses aux questions que l’on nous pose le plus souvent concernant
    une première visite, l’âge minimum, les tarifs, l’adhésion, le matériel et le déroulement
    de nos séances.
{% endblock %}

{% block page_header_content_class %}max-w-3xl{% endblock %}

{% block page_section_class %}max-w-screen-xl mx-auto mb-12 px-4 md:px-6 pt-8 md:pt-10{% endblock %}

{% block page_content_container %}
    <div class="max-w-5xl mx-auto mt-80  py-16">
        {% if faqs|length > 0 %}
            <div id="accordion-collapse" data-accordion="collapse" class="space-y-4">
                {% for faq in faqs %}
                    <div class="collapse collapse-arrow bg-base-100 border-b border-base-300">
                        <input type="radio" name="my-accordion-2" checked="checked"/>
                        <h2 class="collapse-title font-semibold">{{ faq.question }}</h2>
                        <div class="collapse-content leading-xl">
                            {{ faq.answer|raw }}
                            </div>
                    </div>
                {% endfor %}

