{% if parentCategory or childCategories is not empty or relatedPosts is not empty %}
    <aside class="max-w-[61rem] mx-auto  mt-8 mb-12 px-4 md:px-6 pt-8 md:pt-10 border-l-2 border-gold rounded-md">
        {#        <div class="flex flex-col gap-8"> #}
        <div class="max-w-2xl">
            <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-primary">
                <b>Aller plus loin</b>
            </p>
        </div>
        <ul>
            {% if parentCategory %}
                <li class="list-none ml-0 border-b border-base-300/70 pb-3 last:border-b-0 last:pb-0 before:content-['→'] -before:ml-8 before:text-primary">
                    <a href="{{ path('app_category_show', { slug: parentCategory.slug }) }}"
                       class="ml-4 font-medium text-base-content transition-colors hover:text-primary">
                        {{ parentCategory.title }}
                    </a>
                </li>
            {% endif %}

            {% if childCategories is not empty %}
                {% for child in childCategories %}
                    <li class="list-none ml-0 border-b border-base-300/70 pb-3 last:border-b-0 last:pb-0 before:content-['→'] -before:ml-8 before:text-primary">
                        <a href="{{ path('app_category_show', { slug: child.slug }) }}"
                           class="ml-4 font-medium text-base-content transition-colors hover:text-primary">
                            {{ child.title }}
                        </a>
                    </li>
                {% endfor %}
            {% endif %}

            {% if relatedPosts is not empty %}
                {% for post in relatedPosts %}

                    <li class="list-none ml-0 border-b border-base-300/70 pb-3 last:border-b-0 last:pb-0 before:content-['→'] -before:ml-8 before:text-primary">
                        <a href="{{ path('app_post_show', {
                            categorySlug: category.slug,
                            slug: post.slug
                        }) }}"
                           class="ml-4 font-medium text-base-content transition-colors hover:text-primary">
                            {{ post.title }}
                        </a>
                    </li>
                {% endfor %}
            {% endif %}
        </ul>
    </aside>
{% endif %}
