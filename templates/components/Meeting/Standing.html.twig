<div{{ attributes }}>
    <select data-model="year" class="mb-4 p-2 border border-base-light rounded bg-surface-light text-content-primary-light dark:bg-surface-dark dark:text-content-primary-dark dark:border-base-dark">
        {% for availableYear in this.availableYears %}
            <option value="{{ availableYear }}" {% if availableYear == (year|default('')) %}selected{% endif %}>
                {{ availableYear }}
            </option>
        {% endfor %}
    </select>

    {% set standings = this.standings|default([]) %}
    {% if standings is not empty %}
        <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
            <table class="table-auto w-full bg-surface-light dark:bg-surface-dark text-sm text-left rtl:text-right text-content-primary-light dark:text-content-primary-dark">
                <thead class="text-xs uppercase bg-base-light/50 dark:bg-base-dark/50 text-content-primary-light dark:text-content-primary-dark">
                <tr>
                    <th scope="col" class="px-3 py-3">#</th>
                    <th scope="col" class="px-3 py-3"> </th>
                    <th scope="col" class="px-3 py-3 whitespace-nowrap">Participant</th>
                    <th scope="col" class="px-3 py-3 text-center whitespace-nowrap">
                        <span class="block md:hidden">Part.</span>
                        <span class="hidden md:block">Participations</span>
                    </th>
                    <th scope="col" class="px-3 py-3 text-center whitespace-nowrap">
                        <span class="block md:hidden">Plaq.</span>
                        <span class="hidden md:block">{{ 'meeting.points'|trans }}</span>
                    </th>
                    <th scope="col" class="px-3 py-3 text-center whitespace-nowrap">
                        <span class="block md:hidden">{{ 'meeting.avgHits_min'|trans }}</span>
                        <span class="hidden md:block">{{ 'meeting.avgHits'|trans }}</span>
                    </th>
                </tr>
                </thead>
                <tbody>
                {% set prevMeetingPosition = null %}
                {% for row in standings %}
                    {% set previousRank = row.previousRank|default(null) %}
                    {% set change = (previousRank is not null and previousRank > 0) ? (previousRank - row.rank) : null %}
                    <tr class="border-b border-base-light dark:border-base-dark
                            {% if loop.index == 1 %} bg-yellow-400 bg-opacity-25
                            {% elseif loop.index == 2 %} bg-gray-400 bg-opacity-25
                            {% elseif loop.index == 3 %} bg-amber-700 bg-opacity-25
                            {% else %} bg-transparent {% endif %}">
                        <td class="px-3 py-4 font-medium whitespace-nowrap">
                            {% if row.rank != prevMeetingPosition %}
                                {{ row.rank }}
                            {% endif %}
                            {% set prevMeetingPosition = row.rank %}
                        </td>
                        <td class="p-3">
                            {% if change is null %}
                                <span>-</span>
                            {% elseif change > 0 %}
                                <span class="text-green-900">↗ +{{ change }}</span>
                            {% elseif change < 0 %}
                                <span class="text-red-900">↘ {{ change }}</span>
                            {% else %}
                                <span>→ =</span>
                            {% endif %}
                        </td>
                        <td class="px-3 py-4 whitespace-nowrap">
                            {{ row.firstName }} {{ row.lastName|first }}.
                            {% if row.usesSupport|default(false) %}
                                <span class="text-xs">*</span>
                            {% endif %}
                        </td>
                        <td class="px-3 py-4 text-center">{{ row.meetingCount|default('—') }}</td>
                        <td class="px-3 py-4 text-center">{{ row.totalScore|default('—') }}</td>
                        <td class="px-3 py-4 text-center">{{ row.averageHits|default('—') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <div class="mt-2 text-xs text-content-secondary-light dark:text-content-secondary-dark">
                <p class="md:hidden">Plaq. : nombre de plaquettes abattues<br>Part. : nombre de participations</p>
                <p>* Tir réalisé avec appui</p>
            </div>
        </div>
    {% else %}
        <div class="p-4 text-sm text-content-primary-light bg-surface-light border border-surface-light rounded-lg dark:bg-surface-dark dark:text-content-primary-dark dark:border-surface-dark">
            Aucun classement disponible pour le moment.
        </div>
    {% endif %}
</div>
