{% extends 'base.html.twig' %}

{% block title %}Saisie des tirs{% endblock %}

{% block body %}
    <div class="container bg-surface-light dark:bg-surface-dark text-content-primary-light dark:text-content-primary-dark x-auto p-4">
        <twig:Title:H1
                class="text-2xl font-bold mb-4">{% if meeting.label is defined %}{{ meeting.label }}{% endif %}</twig:Title:H1>
        <twig:Title:H2>Passe {{ round.number }}</twig:Title:H2>

        {{ form_start(form) }}
        {{ form_errors(form) }}

        <div class="mt-6 overflow-x-auto" {{ stimulus_controller('toggle_target') }}>
            <table class="w-full text-xs text-left border border-content-primary-light/10 dark:border-content-primary-dark/10">
                <thead class="uppercase bg-base-light dark:bg-base-dark">
                <tr>
                    <th class="py-1.5 px-2 text-content-primary-light dark:text-content-primary-dark text-center w-auto">P</th>
                    <th class="p-1.5 text-content-primary-light dark:text-content-primary-dark text-left w-1/3">Tireur</th>
                    <th class="p-1.5 text-content-primary-light dark:text-content-primary-dark text-center w-1/3">Score</th>
                    <th class="p-1.5 text-content-primary-light dark:text-content-primary-dark text-center w-1/3">Score</th>
                </tr>
                </thead>
                <tbody>
                {% for roundShotForm in form.roundShots %}
                    {% set roundShot = roundShotForm.vars.data %}
                    <tr class="even:bg-base-light/30 dark:even:bg-base-dark/30 border-b border-content-primary-light/20 dark:border-content-primary-light/20 ">
                        <td class="py-1.5 px-2 w-auto text-content-primary-light dark:text-content-primary-dark">
                            <div class="flex items-center justify-center">
                                {{ roundShot.meetingParticipant.position }}
                            </div>
                        </td>
                        <td class="p-1.5 text-content-primary-light dark:text-content-primary-dark w-1/3 ">
                            {% if roundShot.meetingParticipant.shooter is defined and roundShot.meetingParticipant.shooter %}
                                {{ roundShot.meetingParticipant.shooter.firstName }}
                                <br/> {{ roundShot.meetingParticipant.shooter.lastName }}
                            {% else %}
                                Inconnu
                            {% endif %}
                        </td>
                        <td class="p-1.5 text-content-primary-light dark:text-content-primary-dark w-1/3">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <input
                                        type="checkbox"
                                        id="{{ roundShotForm.leftHit.vars.id }}"
                                        name="{{ roundShotForm.leftHit.vars.full_name }}"
                                        value="{{ roundShotForm.leftHit.vars.value }}"
                                        data-index="{{ loop.index0 }}"
                                        {% if roundShotForm.leftHit.vars.checked %}checked{% endif %}
                                        class="w-6 h-6 -ml-1 rounded bg-gray-100 border-gray-300 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600"
                                        {{ stimulus_target('toggle-target', 'leftHit') }}
                                        {{ stimulus_action('toggle-target', 'toggleLeft') }}
                                />

                                {% do roundShotForm.leftHit.setRendered %}

                                {{ form_widget(roundShotForm.leftTarget, {
                                    attr: {
                                        'disabled': 'disabled',
                                        'data-toggle-target-target': 'leftTarget'
                                    }
                                }) }}
                            </div>
                        </td>
                        <td class="p-1.5 text-content-primary-light dark:text-content-primary-dark w-1/3">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <input
                                        type="checkbox"
                                        id="{{ roundShotForm.rightHit.vars.id }}"
                                        name="{{ roundShotForm.rightHit.vars.full_name }}"
                                        value="{{ roundShotForm.rightHit.vars.value }}"
                                        data-index="{{ loop.index0 }}"
                                        {% if roundShotForm.rightHit.vars.checked %}checked{% endif %}
                                        class="w-6 h-6 rounded text-blue-600 bg-gray-100 border-gray-300 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600"
                                        {{ stimulus_target('toggle-target', 'rightHit') }}
                                        {{ stimulus_action('toggle-target', 'toggleRight') }}
                                />
                                {% do roundShotForm.rightHit.setRendered %}
                                {{ form_widget(roundShotForm.rightTarget, {
                                    attr: {
                                        'disabled': 'disabled',
                                        'data-toggle-target-target': 'rightTarget'
                                    }
                                }) }}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="my-12">
            <div class="flex flex-col-reverse md:flex-row justify-between items-start md:items-center flex-wrap gap-4">
                <!-- Retour à gauche -->
                <a class="flex items-center gap-2 hover:underline"
                   href="{{ path('meeting_show', {id: meeting.id}) }}">
                    {{ ux_icon('flowbite:arrow-left-outline', {'class': 'w-5'}) }}
                    <span>{{ 'button.back'|trans }}</span>
                </a>

                <!-- Actions à droite -->
                <div class="flex gap-3">
                    <twig:Button:Submit>
                        {{ 'button.submit'|trans }}
                    </twig:Button:Submit>
                </div>
            </div>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}

