{% extends 'base.html.twig' %}

{% block title %}{{ meeting.label }} - détails de la séance du {{ meeting.date|date('d/m/Y') }}{% endblock %}

{% block body %}

<section class="bg-surface-light dark:bg-surface-dark container-fluid p-4">

    <twig:Title:H1
            class="after:content-[attr(data-status)] after:block after:p-1  after:border after:border-base-dark dark:after:border-base-light after:text-base-dark dark:after:text-base-light after:text-center after:text-sm after:font-semibold after:absolute after:left-0 after:-bottom-8 relative"
            data-status="{{ ('meeting.status.' ~ meeting.status.value ~ '.label')|trans }}">
        {{ meeting.label ?? ('Séance du ' ~ (meeting.date ? meeting.date|date('d/m/Y') : '')) }}
    </twig:Title:H1>
    
    <div class="w-full grid grid-cols-3 mt-16 mb-8">
        <div>
            Date : {{ meeting.date ? meeting.date|date('d/m/Y') : '' }}
        </div>
        <div>
            Ouverte le : {{ meeting.openedAt ? meeting.openedAt|date('d/m/Y') : '' }}
        </div>
        <div>
            Fermée le : {{ meeting.closedAt ? meeting.closedAt|date('d/m/Y') : '' }}
        </div>
    </div>

    <div class="mt-12">
        <h2 class="text-lg font-semibold mb-4">Participants</h2>

        {% if meeting.participants is defined and meeting.participants|length > 0 %}
            <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
                <table class="w-full text-sm text-left">
                    <thead class="text-xs uppercase bg-surface-light dark:bg-surface-dark">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-content-primary-light dark:text-content-primary-dark">
                            Position
                        </th>
                        <th scope="col" class="px-6 py-3 text-content-primary-light dark:text-content-primary-dark">
                            Participant
                        </th>
                        <th scope="col" class="px-6 py-3 text-content-primary-light dark:text-content-primary-dark">
                            Présent
                        </th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for p in meeting.participants %}
                        <tr class="bg-base-light border-b dark:bg-base-dark dark:border-surface-dark hover:bg-surface-light dark:hover:bg-surface-dark">
                            <td class="px-6 py-4 text-content-primary-light dark:text-content-primary-dark w-32">
                                <form method="post"
                                      action="{{ path('admin_meeting_participant_update_position', {
                                          id: meeting.id,
                                          participant: p.id
                                      }) }}"
                                >
                                    <input type="hidden" name="_token" value="{{ csrf_token('update_position_' ~ p.id) }}">

                                    <input type="number"
                                           name="position"
                                           value="{{ p.position }}"
                                           min="1"
                                           max="{{ meeting.participants|length }}"
                                           class="bg-transparent border border-content-primary-light dark:border-content-primary-dark text-content-primary-light dark:text-content-primary-dark rounded w-12 text-center py-1">

                                    <button type="submit">
                                        🔄
                                    </button>
                                </form>
                            </td>
                            <td class="px-6 py-4 text-content-primary-light dark:text-content-primary-dark">
                                {{ p.shooter.firstName }} {{ p.shooter.lastName }}
                            </td>
                            <td class="px-6 py-4 text-content-primary-light dark:text-content-primary-dark">
                                {% if p.present %}
                                    <span class="inline-block px-2 py-0.5 rounded bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300">Oui</span>
                                {% else %}
                                    <span class="inline-block px-2 py-0.5 rounded bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300">Non</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="text-content-primary-light dark:text-content-primary-dark">
                Aucun participant n'a encore été ajouté.
            </p>
        {% endif %}
    </div>
    
    <div class="my-12">
        <div class="flex justify-between items-center flex-wrap gap-4">
            <!-- Retour à gauche -->
            <a class="flex items-center gap-2 text-blue-600 hover:underline"
               href="{{ path('admin_meeting_index') }}">
                {{ ux_icon('flowbite:arrow-left-outline', {'class': 'w-5'}) }}
                <span>{{ 'button.back_list'|trans }}</span>
            </a>
            
            <!-- Actions à droite -->
            <div class="flex gap-3">
                <twig:Button:Secondary href="#">
                    {{ 'button.edit'|trans }}
                </twig:Button:Secondary>
                
                <twig:Button:Secondary href="{{ path('admin_meeting_add_participant', { 'id': meeting.id }) }}">
                    {{ 'button.add_participant'|trans }}
                </twig:Button:Secondary>
                
                {% if meeting.participants|length > 0 %}
                    <twig:Button:Primary href="{{ path('round_start', {'meeting': meeting.id}) }}">
                        {{ 'button.meeting_start'|trans }}
                    </twig:Button:Primary>
                {% endif %}
            </div>
        </div>
    </div>
</section>
 
{% endblock %}

