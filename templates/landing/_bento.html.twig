<section>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-y-20 md:gap-8 p-4rounded-2xl p-4 md:p-0">

        <!-- colonne gauche pleine hauteur -->
        <div class="bento-card md:col-span-2 md:row-span-2 bg-surface-light dark:bg-surface-dark rounded-2xl p-4 md:p-12 shadow-lg border border-surface-light/50 dark:border-surface-dark/50 flex flex-col justify-between">
{#            <div class="flex items-center gap-3 mb-4">#}
{#                <div>#}
                    <h3 class="text-lg font-bold text-content-primary-light dark:text-content-primary-dark/90">{{ edito.title }}</h3>
{#                </div>#}
{#            </div>#}

            {% for paragraph in edito.firstParagraph   %}
            <p class="leading-loose text-content-primary-light dark:text-content-primary-dark/70">
                {{ paragraph |raw }}
            </p>
            {% endfor %}

            <a href="{{ path('app_post_show', {'categorySlug': edito.category.slug, 'slug': edito.slug}) }}"
               class="inline-flex items-center gap-1 text-secondary hover:text-secondary/70 font-medium mt-4 text-sm">
                {{ "edito.more" |trans }}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
            </a>
        </div>



        <!-- Prochain Événement - en haut à droite -->
        {% if facebookEvent %}
            <div {{ stimulus_controller('event-timer', {startTime: facebookEvent.date|date('c')}) }}
                    class="bento-card md:col-span-2 bg-gradient-to-br from-content-primary-light/20 to-content-secondary/50 rounded-2xl p-6 text-white">
                <div class="flex items-start justify-between mb-4">
                    <h3 class="text-2xl font-bold max-w-sm">Prochain tir</h3>
                    <span class="bg-white/20 px-3 py-1 rounded-full text-sm font-medium">
                        {% set now = date() %}
                        {% set diff = now.diff(facebookEvent.date) %}
                        {% if facebookEvent.date < now %}
                            Il y a {{ diff.days }} jours
                        {% elseif diff.days == 0 %}
                            Aujourd'hui !
                        {% elseif diff.days == 1 %}
                            Demain
                        {% else %}
                            Dans {{ diff.days }} jours
                        {% endif %}
                    </span>
                </div>
                <div class="space-y-4">
                    <div>
                        <p class="text-3xl font-bold mb-2">
                            <a href="{{ path('app_agenda_show', {slug: facebookEvent.slug}) }}"
                               class="hover:underline">{{ facebookEvent.title }}</a>
                        </p>
                        <p class="text-white/90" {{ stimulus_target('event-timer', 'output') }}></p>
                    </div>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div class="bg-white/10 rounded-lg p-3 backdrop-blur-sm">
                            <p class="text-white/70 text-xs mb-1">Date</p>
                            <p class="font-semibold">{{ facebookEvent.date|format_date('long', locale='fr') }}</p>
                        </div>
                        <div class="bg-white/10 rounded-lg p-3 backdrop-blur-sm">
                            <p class="text-white/70 text-xs mb-1">Heure</p>
                            <p class="font-semibold">{{ facebookEvent.date|date('H:i') }}</p>
                        </div>
                    </div>
                    {% if facebookEvent.facebookLink is not null %}
                        <twig:Button:Primary class="w-full" href="{{ facebookEvent.facebookLink }}">
                             Intéressé ? {{ ux_icon('gg:external', {class: 'w-4 ml-6'}) }}
                        </twig:Button:Primary>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="bento-card md:col-span-2 bg-gradient-to-br from-content-primary-light/20 to-content-secondary/50 rounded-2xl p-6 text-white flex flex-col items-center justify-center space-y-8">
                <h3 class="text-2xl font-bold max-w-sm">
                    N'hésitez pas à télécharger notre
                    <a href="{{ asset('calendrier-gc-bernissart_2026.pdf') }}" class="underline mb-4">calendrier
                    2026</a>
                </h3>
                <a href="{{ asset('calendrier-gc-bernissart_2026.pdf') }}" class="underline">
                    <img src="{{ asset('images/screenshot_calendrier_2026.png') }}"
                         alt="Téléchargez le calendrier 2026 | GC Bernissart"
                         class="w-11/12 md:w-72 h-auto rounded-lg">
                </a>
            </div>
        {% endif %}
        <!-- Image - en bas à droite -->
        <div class="bento-card md:col-span-2 rounded-2xl overflow-hidden relative max-h-screen md:max-h-72 ">
            <img src="{{ asset('images/carousel/bento_image.webp') }}"
                 alt="Équipe du club"
                 class="w-full h-full object-cover">
            <div class="absolute top-4 right-4 bg-base-light/60 text-content-primary-light dark:bg-base-dark/70 dark:text-content-primary-dark/80 backdrop-blur-sm px-4 py-2 rounded-full">
                <p class="text-sm font-semibold">
                    <a href="https://www.instagram.com/gcbernissart" class="hover:underline">
                        {{ ux_icon('flowbite:instagram-solid', {class: 'inline-flex w-4 mr-4'}) }} Instagram
                    </a>
                </p>
            </div>
        </div>

    </div>
</section>