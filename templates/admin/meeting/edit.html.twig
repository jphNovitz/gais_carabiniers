{% extends 'base.html.twig' %}

{% block title %}{% trans %}meeting.edit{% endtrans %}{% endblock %}

{% block body %}
    <div class="w-full lg:w-2/3 m-auto p-4">
        <h1 class="mb-8 text-2xl font-extrabold leading-none tracking-tight text-base-content md:text-3xl lg:text-4xl dark:text-base-content/70">
            {% trans %}title.meeting.edit{% endtrans %}
        </h1>

        {{ form_start(basicForm) }}
        <div class="my-8 space-y-12">

            {{ form_errors(basicForm) }}
            <div>
                {{ form_label(basicForm.label) }}
                {{ form_widget(basicForm.label) }}
                {{ form_errors(basicForm.label) }}
            </div>
            <div class="w-full grid md:grid-cols-2 gap-12">
                <div>
                    {{ form_label(basicForm.type) }}
                    {{ form_widget(basicForm.type) }}
                    {{ form_errors(basicForm.type) }}
                </div>
                <div>
                    {{ form_label(basicForm.status) }}
                    {{ form_widget(basicForm.status) }}
                    {{ form_errors(basicForm.status) }}
                </div>
            </div>
            <div class="flex flex-col-reverse md:flex-row justify-between items-start  md:items-center flex-wrap gap-4">
                <!-- Retour à gauche -->
                <a class="flex items-center gap-2  hover:underline"
                   href="{{ path('admin_meeting_index') }}">
                    {{ ux_icon('flowbite:arrow-left-outline', {'class': 'w-5'}) }}
                    <span>{{ 'button.back_list'|trans }}</span>
                </a>

                <!-- Actions à droite -->
                <div class="flex gap-3">
                    <twig:Button:Primary type="submit"> {{ 'button.edit' |trans }}</twig:Button:Primary>
                </div>
            </div>
        </div>

        {{ form_widget(basicForm) }}

    </div>
    {{ form_end(basicForm) }}
{% endblock %}


