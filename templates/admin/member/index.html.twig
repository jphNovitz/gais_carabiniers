{% extends 'base.html.twig' %}

{% block title %}Member index{% endblock %}

{% block body %}
    <div class="container-fluid p-4">
        <div class="mb-4 flex justify-between items-center">
            <h3 class="text-xl font-semibold text-content-primary-light dark:text-content-primary-dark">{{ 'member.list' | trans }}</h3>
            <a href="{{ path('admin_member_new') }}"
               class="px-4 py-2 bg-content-secondary text-white rounded-lg hover:bg-content-secondary/80">
                <i class="fa fa-plus"></i> {{ 'button.add' |trans }}
            </a>
        </div>
        <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
            <table class="w-full text-sm text-left">
                <thead class="text-xs uppercase bg-surface-light dark:bg-surface-dark">
                <tr>
                    <th scope="col"
                        class="px-6 py-3 text-content-primary-light dark:text-content-primary-dark">{{ 'form.firstname'|trans }}</th>
                    <th scope="col"
                        class="px-6 py-3 text-content-primary-light dark:text-content-primary-dark">{{ 'form.lastname'|trans }}</th>
                    <th scope="col"
                        class="px-6 py-3 text-content-primary-light dark:text-content-primary-dark">{{ 'form.active'|trans }}</th>
                    <th scope="col"
                        class="px-6 py-3 hidden md:table-cell text-content-primary-light dark:text-content-primary-dark">
                        Créé le
                    </th>
                    <th scope="col"
                        class="px-6 py-3 hidden md:table-cell text-content-primary-light dark:text-content-primary-dark">
                        Modifié le
                    </th>
                    <th scope="col" class="px-6 py-3 text-content-primary-light dark:text-content-primary-dark">
                        Actions
                    </th>
                </tr>
                </thead>
                <tbody>

                {% for item in members %}
                    <tr class="bg-base-light border-b dark:bg-base-dark dark:border-surface-dark hover:bg-surface-light dark:hover:bg-surface-dark">
                        <th scope="row"
                            class="px-6 py-4 font-medium text-content-primary-light whitespace-nowrap dark:text-content-primary-dark">
                            {{ item.firstName }}
                        </th>
                        <td class="px-6 py-4 text-content-primary-light dark:text-content-primary-dark">
                            {{ item.lastName }}
                        </td>
                        <td class="px-6 py-4 hidden md:table-cell" {{ stimulus_controller('active', {'url': path('toggle_active', {'id': item.id}) }) }}>


                            <label class="inline-flex items-center cursor-pointer">
                                <input data-active-url-value="{{ path('toggle_active', {'id': item.id}) }}"
                                        {{ stimulus_action('active', 'toggle', 'click' ) }}
                                       type="checkbox" value=""
                                       class="sr-only peer" {% if item.isActive %} checked {% endif %}>
                                <span
                                        class="relative w-11 h-6 bg-gray-200 rounded-full peer peer-focus:ring-4 peer-focus:ring-blue-300 dark:peer-focus:ring-blue-800 dark:bg-gray-700 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-blue-600 dark:peer-checked:bg-blue-600"></span>
                            </label>


                            {#                                {{ item.isActive ? 'Oui' : 'Non' }} #}
                        </td>
                        <td class="px-6 py-4 hidden md:table-cell text-content-primary-light dark:text-content-primary-dark">
                            {{ item.createdAt ? item.createdAt|date('d/m/Y') : '' }}
                        </td>
                        <td class="px-6 py-4 hidden md:table-cell text-content-primary-light dark:text-content-primary-dark">
                            {{ item.updatedAt ? item.updatedAt|date('d/m/Y') : '' }}
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex space-x-2">
                                <a href="{{ path('admin_member_edit', {'slug': item.slug}) }}"
                                   class="px-3 py-1.5 bg-content-highlight-light dark:bg-content-highlight-dark/70 text-content-primary-dark dark:text-content-primary-light rounded hover:bg-content-highlight-light/60 dark:hover:bg-content-highlight-dark/50">
                                    <i class="fas fa-edit">{% trans %}button.edit{% endtrans %}</i>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr class="bg-base-light dark:bg-base-dark">
                        <td colspan="6"
                            class="px-6 py-4 text-center text-content-primary-light dark:text-content-primary-dark">
                            {{ 'member.na' |trans }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
