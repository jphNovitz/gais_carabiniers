{% extends 'base.html.twig' %}

{% block title %}Ajouter des participants{% endblock %}

{% block body %}
    <div class="container-fluid bg-surface-light dark:bg-surface-dark p-4">
        <h3 class="text-xl font-semibold text-content-primary-light dark:text-content-primary-dark">
                Ajouter des participants
        </h3> 
        <div class="shadow-md sm:rounded-lg p-6">
            {{ form_errors(form) }}

            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
            <div class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 flow-cols p-8">
                {% for shooter in form.shooters %}
                    <div class="flex items-center space-x-2">
                        {{ form_widget(shooter, {'attr': {'class': 'rounded'}}) }}
                        {{ form_label(shooter, null, {'label_attr': {'class': 'hidden'}}) }}
                    </div>
                {% endfor %}
            </div>
            <div class="flex justify-between flex-wrap gap-4">
                <a class="flex items-center"
                   href="{{ path('admin_meeting_index') }}">
                   {{ ux_icon('flowbite:arrow-left-outline', {'class': 'w-6 font-medium'}) }} <span class="underline">{{'button.back_list' |trans}}</span> 
                   </a>
                <div class="space-x-4">
                  <twig:Button:Submit> {{ 'button.add'|trans }} </twig:Button:Submit>
                  <twig:Button:Secondary href="#"> {{'button.edit' |trans}} </twig:Button:Secondary>  
                </div>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

