{% extends '_layout/page_detail.html.twig' %}

{% block title %}Agenda des événements – Gais Carabiniers de Bernissart | Compétitions & Activités{% endblock %}
{% block seo_content %}agenda, événements, compétitions, tir sportif, club de tir, Gais Carabiniers, Bernissart, activités, calendrier, concours de tir, entraînement, rencontres, URSTB-F{% endblock %}
{% block seo_description %}Consultez l’agenda des événements des Gais Carabiniers de Bernissart : compétitions, entraînements et rencontres de tir sportif. Restez informé des prochaines dates !{% endblock %}
{% block og_title %}Découvrez les événements du club de tir – Gais Carabiniers de Bernissart{% endblock %}
{% block og_description %}Ne manquez aucun événement du club de tir des Gais Carabiniers de Bernissart ! Découvrez les compétitions et activités à venir.{% endblock %}
{% block og_image %}https://gc-bernissart.be/images/gc-bernissart_agenda_cover_image.webp{% endblock %}
{% block og_url %}{{ app.request.uri }}{% endblock %}
{% block twitter_title %}Agenda des Gais Carabiniers : entraînements et compétitions{% endblock %}
{% block twitter_description %}Découvrez les événements du club de tir : compétitions, entraînements et rencontres. Ne manquez aucune date importante !{% endblock %}
{% block twitter_image %}https://gc-bernissart.be/images/gc-bernissart_agenda_cover_image.webp{% endblock %}

{% block page_breadcrumb %}
    <ol class="flex flex-wrap items-center gap-2 text-sm text-base-content/65">
        <li>
            <a href="{{ path('app_home') }}" class="transition-colors hover:text-primary">Accueil</a>
        </li>
        <li class="text-base-content/30" aria-hidden="true">›</li>
        <li>
            <a href="{{ path('app_category_show', {'slug': 'competitions-tir-sportif'}) }}"
               class="transition-colors hover:text-primary">
                Compétitions de tir sportif
            </a>
        </li>
        <li class="text-base-content/30" aria-hidden="true">›</li>
        <li aria-current="page" class="font-semibold tracking-[0.08em] text-base-content/95">Agenda</li>
    </ol>
{% endblock %}

{% block page_title %}Agenda{% endblock %}

{% block page_summary %}
    <p>Retrouvez les prochains rendez-vous du club et les événements déjà passés.</p>
    <a href="{{ asset('calendrier-gc-bernissart_2026.pdf') }}" class="link link-primary font-semibold">
        Télécharger le calendrier 2026
    </a>
{% endblock %}

{% block page_content %}
    <h2>Événements à venir</h2>
    {% if facebook_events is not empty %}
        <ul class="not-prose mt-6 divide-y divide-base-300 border-y border-base-300">
            {% for item in facebook_events %}
                <li class="relative py-5 pl-7 before:absolute before:left-0 before:top-5 before:text-primary before:content-['→']">
                    <time datetime="{{ item.date|date('Y-m-d') }}" class="block text-sm font-semibold uppercase tracking-[0.12em] text-base-content/55">
                        {{ item.date|format_date(locale='fr', pattern='dd MMMM yyyy') }}
                    </time>
                    <a href="{{ path('app_agenda_show', {'slug': item.slug}) }}" class="mt-1 inline-block text-lg font-semibold text-base-content transition-colors hover:text-primary">
                        {{ item.title }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="not-prose mt-6 rounded-box border border-dashed border-base-300 p-5 text-base-content/70">
            Aucun événement à venir.
        </p>
    {% endif %}

    <h2>Événements passés</h2>
    {% if facebookEventsPast is not empty %}
        <ul class="not-prose mt-6 divide-y divide-base-300 border-y border-base-300 text-base-content/75">
            {% for item in facebookEventsPast %}
                <li class="relative py-4 pl-7 before:absolute before:left-0 before:top-4 before:text-primary before:content-['→']">
                    <a href="{{ path('app_agenda_show', {'slug': item.slug}) }}" class="transition-colors hover:text-primary">
                        <time datetime="{{ item.date|date('Y-m-d') }}" class="font-semibold text-base-content/55">
                            {{ item.date|format_date(locale='fr', pattern='MMMM Y') }}
                        </time>
                        <span class="ml-2 font-semibold text-base-content">{{ item.title }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="not-prose mt-6 rounded-box border border-dashed border-base-300 p-5 text-base-content/70">
            Pas d'événements passés.
        </p>
    {% endif %}
{% endblock %}

{% block page_aside_content %}
    <section class="rounded-box border border-base-300 bg-base-200 p-6 md:p-8" aria-labelledby="agenda-contact-title">
        <h2 id="agenda-contact-title" class="mt-0 text-2xl text-base-content">Une question sur un événement ?</h2>
        <p class="mt-3 text-base-content/75">
            N'hésitez pas à <a href="{{ path('app_contact') }}" class="link link-primary font-semibold">nous contacter</a> pour plus d'informations.
        </p>
    </section>
{% endblock %}
