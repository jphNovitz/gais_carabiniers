{% extends 'base.html.twig' %}

{% block title %}{% trans %}club.about {% endtrans %}{% endblock %}

{% block body %}

    <section id="nous-contacter"
             class="w-full bg-surface-light dark:bg-surface-dark pt-4 pb-8 px-4 rounded-lg flex flex-col lg:flex-row">
        <article class="w-full lg:w-1/2 sm:p-16 xl:p-24">
            <h2 class="text-4xl font-headland font-extrabold text-content-highlight-light/70 dark:text-content-highlight-dark/70">
                Nous trouver, <br/>nous contacter, <br/>nous
                rencontrer </h2>
            <h3 class="my-4 text-xl font-headland font-semibold text-content-highlight-light/70 dark:text-content-highlight-dark/70">Comment se rendre chez Les Gais Carabiniers de Bernissart ?</h3>
            <p class="font-black text-lg  text-content-primary-light/50 lg:text-xl  dark:text-content-primary-dark/40 leading-loose">
                Notre club n'est pas visible de la rue. <br class="hidden md:block"/> Une fois arrivés dans la rue Lotard, suivez les panneaux "ALE".
                Nous sommes situés juste derrière le Musée de l'Iguanodon de Bernissart.

            </p>
            <p class="font-black text-lg  text-content-primary-light/50 lg:text-xl  dark:text-content-primary-dark/40 leading-loose">
                Voici les <a href="https://www.google.com/maps?q=50.475936,3.6499715" class="text-content-highlight-light/70 dark:text-content-highlight-dark/70 underline">coordonnées GPS de GC Bernissart</a> pour vous aider à nous localiser :
            </p>
            <ul class="font-black text-lg  text-content-primary-light/50 lg:text-xl  dark:text-content-primary-dark/40 leading-loose">
                    <li>Latitude: 50.4758127</li>
                    <li>Longitude: 3.6487768</li>
            </ul>

            <p class="my-8 text-lg font-normal text-content-primary-light/50 lg:text-xl {# sm:px-16 xl:px-48 #} dark:text-content-primary-dark/40 leading-loose">
                Que vous veniez de Bernissart, Péruwelz, Saint-Ghislain ou Condé-sur-l'Escaut, profitez
                d'une ambiance
                conviviale et découvrez les joies du tir sportif. Une expérience unique à partager en toute
                sécurité
                !
            </p>
        </article>
        <article class="w-full lg:w-1/2 p-4">
            {{ ux_map(myMap, { class: 'w-full  aspect-video lg:aspect-square mx-auto' }) }}
        </article>
    </section>

{% endblock %}

