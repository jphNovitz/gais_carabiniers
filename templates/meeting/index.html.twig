{% extends 'base.html.twig' %}

{% block body %}



    <section class="max-w-6xl mx-auto p-8 space-y-12">
        {% for year, meetings in meetingsByYear %}
            <div>
                <h2 class="text-2xl font-bold mb-6">{{ year }}</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    {% for meeting in meetings %}
                    <a href="{{ path('meeting_show', {'id': meeting.id}) }}" class="block p-4 bg-surface-light dark:bg-surface-dark rounded-xl shadow hover:bg-base-300 transition">
                        <h3 class="font-semibold text-lg mb-1">{{ meeting.title}}</h3>
                        <p class="text-sm text-gray-600">{{ meeting.date|format_datetime('long', 'none') }}
                        <p class="text-sm mt-2">{{ meeting.participantCount }} participants</p>
                        </a>

                    {% endfor %}
                </div>
            </div>
        {% else %}
            <p>Pas de compétition</p>
        {% endfor %}
    </section>

{% endblock %}