{% extends 'base.html.twig' %}

{% block title %}{{ meeting.label }} - détails de la séance du {{ meeting.date|date('d/m/Y') }}{% endblock %}

{% block body %}
    <section class="container-fluid p-4">

        <twig:Title:H1
                class="after:content-[attr(data-status)] after:block after:p-1  after:border after:border-base-dark dark:after:border-base-light after:text-base-dark dark:after:text-base-light after:text-center after:text-sm after:font-semibold after:absolute after:left-0 after:-bottom-8 relative"
                data-status="{{ ('meeting.status.' ~ meeting.status ~ '.label')|trans }}">
            {{ meeting.label ?? ('Séance du ' ~ (meeting.date ? meeting.date|date('d/m/Y') : '')) }}
        </twig:Title:H1>
        <div class="w-full grid grid-cols-6 mt-16 mb-8">
            <div>
                Date : {{ meeting.date ? meeting.date|date('d/m/Y') : '' }}
            </div>
            <div>
                Création : {{ meeting.createdAt ? meeting.createdAt|date('d/m/Y') : '' }}
            </div>
            <div>
                Modifiée le : {{ meeting.updatedAt ? meeting.updatedAt|date('d/m/Y') : '' }}
            </div>
            <div>
                Ouverte le : {{ meeting.openedAt ? meeting.openedAt|date('d/m/Y') : '' }}
            </div>
            <div>
                Fermée le : {{ meeting.closedAt ? meeting.closedAt|date('d/m/Y') : '' }}
            </div>
        </div>


        <div class="mt-12">
            <h2 class="text-lg font-semibold mb-4">Participants</h2>
            {{dump(meeting.participants)}}
            {% if meeting.participants is defined and meeting.participants|length > 0 %}
                <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
                    <table class="w-full text-sm text-left">
                        <thead class="text-xs uppercase bg-surface-light dark:bg-surface-dark">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-content-primary-light dark:text-content-primary-dark">
                                Position
                            </th>
                            <th scope="col" class="px-6 py-3 text-content-primary-light dark:text-content-primary-dark">
                                Participant
                            </th>
                            <th scope="col" class="px-6 py-3 text-content-primary-light dark:text-content-primary-dark">
                                Présent
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for p in meeting.participants %}
                            <tr class="bg-base-light border-b dark:bg-base-dark dark:border-surface-dark hover:bg-surface-light dark:hover:bg-surface-dark">
                                <td class="px-6 py-4 text-content-primary-light dark:text-content-primary-dark w-24">{{ p.position }}</td>
                                <td class="px-6 py-4 text-content-primary-light dark:text-content-primary-dark">{{ p.shooter.firstName }} {{ p.shooter.lastName }}</td>
                                <td class="px-6 py-4 text-content-primary-light dark:text-content-primary-dark">
                                    {% if p.present %}
                                        <span class="inline-block px-2 py-0.5 rounded bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300">Oui</span>
                                    {% else %}
                                        <span class="inline-block px-2 py-0.5 rounded bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300">Non</span>
                                    {% endif %}
                                </td>
                            </tr>
                            {% else %}


                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="text-content-primary-light dark:text-content-primary-dark">Aucun participant n'a encore été
                    ajouté.</p>
            {% endif %}
        </div>
        <div class="my-12 flex flex-col space-y-8">
            <div class="flex flex-wrap gap-4">
                <a class="text-white bg-content-secondary/90 hover:bg-content-secondary/90 focus:outline-none focus:ring-4 focus:ring-content-secondary/30 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-content-secondary/70 dark:hover:bg-content-secondary/80 dark:focus:ring-content-secondary/90"
                   href="{{ path('round_start', {'meeting': meeting.id}) }}">
                    {% if meeting.rounds|length >0 %}
                        Nouveau tour
                    {% else %}
                        Démarrer la séance
                    {% endif %}
                </a>
                <a class="text-white bg-content-secondary/90 hover:bg-content-secondary/90 focus:outline-none focus:ring-4 focus:ring-content-secondary/30 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-content-secondary/70 dark:hover:bg-content-secondary/80 dark:focus:ring-content-secondary/90"
                   href="#">Clôturer</a>
            </div>
            <div class="flex flex-wrap gap-4">
                <a class="bg-transparent text-content-secondary border border-content-secondary hover:bg-content-secondary/10 focus:outline-none focus:ring-4 focus:ring-content-secondary/30 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:text-content-secondary dark:border-content-secondary dark:hover:bg-content-secondary/20"
                   href="{{ path('admin_meeting_add_participant', { 'id': meeting.id }) }}">Ajouter des participants</a>
                <a class="bg-transparent text-content-secondary border border-content-secondary hover:bg-content-secondary/10 focus:outline-none focus:ring-4 focus:ring-content-secondary/30 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:text-content-secondary dark:border-content-secondary dark:hover:bg-content-secondary/20"
                   href="#">Modifier</a>
                <a class="bg-transparent text-content-secondary border border-content-secondary hover:bg-content-secondary/10 focus:outline-none focus:ring-4 focus:ring-content-secondary/30 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:text-content-secondary dark:border-content-secondary dark:hover:bg-content-secondary/20"
                   href="{{ path('admin_meeting_index') }}">Retour à la liste</a>
            </div>
        </div>
    </section>
{% endblock %}

