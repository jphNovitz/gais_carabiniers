{% extends '@EasyAdmin/page/content.html.twig' %}

{% block title %}{{ meeting.label }} - détails de la séance du {{ meeting.date|date('d/m/Y') }}{% endblock %}

{% block content %}

    <div class="d-flex flex-column gap-3">
        {#    custom navbar #}
        <div class="w-100 d-flex justify-content-between align-items-center mb-4">
            <h1 class="title h3">Liste des tireurs — {{ meeting.label }}</h1>
            <a href="{{ ea_url()
                .setController('App\\Controller\\Admin\\Meeting\\MeetingCrudController')
                .setAction('edit')
                .setEntityId(meeting.id)
                .generateUrl() }}"
               class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Retour à la modification
            </a>
                <a href="{{ path('round_start', {'meeting': meeting.id}) }}" class="btn btn-secondary">
                    {% if meeting.rounds|length > 0 %}
                        {{ 'button.meeting_continue'|trans }}
                    {% else %}
                        {{ 'button.meeting_start'|trans }}
                    {% endif %}
                </a>
{#            <a href="{{ path('nom_de_ta_route', {id: meeting.id}) }}" class="btn btn-secondary">#}
{#                <i class="fas fa-arrow-left me-1"></i> Retour#}
{#            </a>#}
        </div>

        <div class="w-100 d-flex flex-row gap-2">
            <div>
                Date : {{ meeting.date ? meeting.date|date('d/m/Y') : '' }}
            </div>
            <div>
                Ouverte le : {{ meeting.openedAt ? meeting.openedAt|date('d/m/Y') : '' }}
            </div>
        </div>

        <div class="mt-12">
            <h2 class="title h4">Participants</h2>

            <twig:Meeting:ParticipantList meeting="{{ meeting }}"/>

        </div>

        <div class="my-12">
            <div class="flex flex-col-reverse md:flex-row justify-between items-start  md:items-center flex-wrap gap-4">
                <!-- Retour à gauche -->
                <a class="flex items-center gap-2  hover:underline"
                   href="{{ path('admin_meeting_index') }}">
                    {{ ux_icon('flowbite:arrow-left-outline', {'class': 'w-5'}) }}
                    <span>{{ 'button.back_list'|trans }}</span>
                </a>

                <!-- Actions à droite -->
                <div class="flex gap-3">
                    <twig:Button:Secondary href="#">
                        {{ 'button.edit'|trans }}
                    </twig:Button:Secondary>

                    {% if meeting.participants|length > 0 %}
                        <twig:Button:Primary href="{{ path('round_start', {'meeting': meeting.id}) }}">
                            {{ 'button.meeting_start'|trans }}
                        </twig:Button:Primary>
                    {% else %}
                        <twig:Button:Primary href="{{ path('admin_meeting_add_participant', { 'id': meeting.id }) }}">
                            {{ 'button.add_participant'|trans }}
                        </twig:Button:Primary>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>
{% endblock %}

