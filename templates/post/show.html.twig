{# templates/post/show.html.twig #}
{% extends '_layout/page_detail.html.twig' %}

{% block title %}{{ post.title }}{% endblock %}
{% set urlCategory = post.category ? (post.category.parentCategory ?? post.category) : null %}

{% block page_breadcrumb %}
    <ol class="flex flex-wrap items-center gap-2 text-sm text-base-content/65">
        <li>
            <a href="{{ path('app_home') }}" class="transition-colors hover:text-primary">
                Accueil
            </a>
        </li>
        {% if urlCategory %}
            <li class="text-base-content/30" aria-hidden="true">›</li>
            <li>
                <a href="{{ path('app_category_show', {'slug': urlCategory.slug}) }}"
                   class="transition-colors hover:text-primary">
                    {{ urlCategory.title }}
                </a>
            </li>
        {% endif %}
        <li class="text-base-content/30" aria-hidden="true">›</li>
        <li aria-current="page" class="font-semibold tracking-[0.08em] text-base-content/95">
            {{ post.title }}
        </li>
    </ol>
{% endblock %}

{% block page_header_top %}
    {% if post.category %}
        <div class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.22em] text-primary font-bold mb-4">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            {{ post.category }}
        </div>
    {% endif %}
{% endblock %}

{% block page_title %}{{ post.title }}{% endblock %}

{% block page_summary %}
    {{ post.summary }}
{% endblock %}

{% block page_media %}
    {% if post.image %}
        <figure class="mb-8 overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-md">
            <img src="{{ asset(post.image) }}" alt="{{ post.title }}" class="h-72 w-full object-cover md:h-[32rem]">
        </figure>
    {% endif %}
{% endblock %}

{% block page_content %}
    {{ post.content|raw }}
{% endblock %}

{% block page_aside_content %}
    <twig:Post:RelatedPosts :post="post" limit="4"/>
{% endblock %}
