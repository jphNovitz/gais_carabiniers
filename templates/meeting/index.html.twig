{% extends '_layout/page_detail.html.twig' %}

{% block page_breadcrumb %}
    <ol class="flex flex-wrap items-center gap-2 text-sm text-base-content/65">
        <li>
            <a href="{{ path('app_home') }}" class="transition-colors hover:text-primary">Accueil</a>
        </li>
        <li class="text-base-content/30" aria-hidden="true">›</li>
        <li>
            <a href="{{ path('app_category_show', {'slug': 'competitions-tir-sportif'}) }}" class="transition-colors hover:text-primary">
                Compétitions de tir sportif
            </a>
        </li>
        <li class="text-base-content/30" aria-hidden="true">›</li>
        <li aria-current="page" class="font-semibold tracking-[0.08em] text-base-content/95">
            Résultats des tirs aux plaquettes
        </li>
    </ol>
{% endblock %}

{% block page_title %}Résultats des tirs aux plaquettes{% endblock %}

{% block page_summary %}
    Tout au long de l'année, les Gais Carabiniers organisent des rencontres pour partager notre passion du tir sur plaquettes.
    Consultez aussi notre <a href="{{ path('app_agenda') }}" class="link link-primary font-semibold">agenda des tirs aux plaquettes</a>.
{% endblock %}

{% block page_content %}
    {% set meetingTypeLabels = {
        competition: 'Tirs du mois',
        public: 'Tir public',
        other: 'Autres tirs'
    } %}

    <div class="not-prose space-y-12">
        {% for year, grouped in groupedMeetings %}
            <section>
                <h2 class="mb-6 text-2xl font-bold">Saison {{ year }}</h2>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                    {% for type, meetings in grouped %}
                        <section class="overflow-hidden rounded-box border border-base-300 bg-base-200/60">
                            <h3 class="border-b border-base-300 px-4 py-3 text-xl font-bold text-base-content">
                                {{ meetingTypeLabels[type]|default('Autre tir') }}
                            </h3>
                            <div class="divide-y divide-base-300 px-4">
                                {% for meeting in meetings %}
                                    <article class="py-4">
                                        <h4 class="text-lg font-bold text-base-content">{{ meeting.title }}</h4>
                                        <div class="grid grid-cols-2 gap-2">
                                            <div class="text-sm">{{ meeting.date|format_datetime('long', 'none') }}</div>
                                            <div class="text-sm">{{ meeting.participantCount }} participants</div>
                                        </div>
                                        <div class="mt-3 grid grid-cols-1 gap-2 lg:grid-cols-2">
                                            <a href="{{ path('app_meeting_show_category', {'slug': meeting.slug, 'category': 'standard'}) }}"
                                               class="inline-flex w-full items-center justify-center whitespace-nowrap rounded-md border border-content-primary-light/20 px-3 py-2 text-center text-sm font-semibold hover:border-secondary hover:text-secondary md:text-[11px] xl:text-sm dark:border-content-primary-dark/20">
                                                Résultats standard
                                            </a>
                                            <a href="{{ path('app_meeting_show_category', {'slug': meeting.slug, 'category': 'appuye'}) }}"
                                               class="inline-flex w-full items-center justify-center whitespace-nowrap rounded-md border border-content-primary-light/20 px-3 py-2 text-center text-sm font-semibold hover:border-secondary hover:text-secondary md:text-[11px] xl:text-sm dark:border-content-primary-dark/20">
                                                Résultats appuyés
                                            </a>
                                        </div>
                                    </article>
                                {% endfor %}
                            </div>
                        </section>
                    {% endfor %}
                </div>
            </section>
        {% else %}
            <p class="rounded-box border border-dashed border-base-300 p-5 text-base-content/70">Pas de compétition.</p>
        {% endfor %}
    </div>
{% endblock %}
