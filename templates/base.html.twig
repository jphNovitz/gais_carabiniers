<!DOCTYPE html>
<html lang="fr_BE" class="scroll-smooth" >
<head>
    <!-- Meta classiques -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Les Gais Carabiniers - Club de Tir à Bernissart{% endblock %}</title>
    <meta name="keywords"
          content="{% block seo_content %}tir sportif, Bernissart, Les Gais Carabiniers, carabine, club de tir, URSTB-F, tir 10m, tir 12m, ambiance conviviale, passion tir, sécurité, air comprimé{% endblock %}">
    <meta name="description"
          content="{% block seo_description %}Rejoignez les Gais Carabiniers de Bernissart, un club de tir à la carabine convivial et passionné. Découvrez nos disciplines de tir 10m et 12m, participez à nos événements comme le Critérium Daniel Manfroid, et partagez votre passion dans un cadre sécurisé. Inscriptions ouvertes !{% endblock %}">
    <meta name="author" content="{% block seo_author %}Novitz Jean-Philippe{% endblock %}">
    <meta name="robots" content="{% block seo_robots %}index, follow{% endblock %}">
    <meta name="view-transition" content="same-origin"/>
    <link rel="canonical" href="{{ app.request.uri }}">

    <!-- Open Graph / Facebook -->
    <meta property="og:title"
          content="{% block og_title %}Gais Carabiniers de Bernissart - Club de tir à la carabine{% endblock %}">
    <meta property="og:description"
          content="{% block og_description %}Participez aux événements de tir des Gais Carabiniers à Bernissart, comme le Critérium Daniel Manfroid ! Découvrez nos disciplines 10m et 12m et rejoignez une communauté conviviale.{% endblock %}">
    <meta property="og:image"
          content="{% block og_image %}https://gc-bernissart.be/images/carousel/gais-carabiniers-slider_01.jpg{% endblock %}">
    <meta property="og:url" content="{% block og_url %}https://gc-bernissart.be{% endblock %}">
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">

    <!-- Twitter -->
    <meta name="twitter:card" content="{% block twitter_card %}summary_large_image{% endblock %}">
    <meta name="twitter:title"
          content="{% block twitter_title %}Découvrez le Club de tir - Gais Carabiniers de Bernissart{% endblock %}">
    <meta name="twitter:description"
          content="{% block twitter_description %}Envie de défi ? Participez à nos concours de tir 10m et 12m, comme le Critérium Daniel Manfroid. Rejoignez-nous à Bernissart !{% endblock %}">
    <meta name="twitter:image"
          content="{% block twitter_image %}https://gc-bernissart.be/images/carousel/gais-carabiniers-slider_01.jpg{% endblock %}">


    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico?v=1.0" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Teko:wght@400;500;600;700&family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet">

    {% block stylesheets %}
        {#        <link rel="stylesheet" href="{{ asset('styles/app.css') }}"> #}

    {% endblock %}
    {% block json_ld %} {% endblock %}
    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}
</head>
<body class="w-full overflow-x-hidden min-h-screen h-auto bg-base-100 text-base-content p-0">
{% include '_header/_header.html.twig' %}
<div class="w-full md:max-w-screen-xl mx-auto text-base leading-relaxed p-4">
    <div class="w-full">
{#        breadcrumb#}
        {% block nav_secondary %} {% endblock %}
{#        end breadcrumb#}
    </div>
    <main class="w-full p-0">
        {% block body %}{% endblock %}
    </main>
</div>
{% include '_footer/_footer.html.twig' %}
{% block js %}
{% endblock %}
</body>
</html>
