{% extends '_layout/page_detail.html.twig' %}

{% set eventDescription = facebookEvent.description ? facebookEvent.description|striptags|slice(0, 160) : 'Informations sur cet événement des Gais Carabiniers de Bernissart.' %}

{% block title %}{{ facebookEvent.title }} | Agenda | Gais Carabiniers de Bernissart{% endblock %}
{% block seo_content %}agenda, événement, compétition, tir sportif, Gais Carabiniers, Bernissart{% endblock %}
{% block seo_description %}{{ eventDescription }}{% endblock %}
{% block og_title %}{{ facebookEvent.title }} | Gais Carabiniers de Bernissart{% endblock %}
{% block og_description %}{{ eventDescription }}{% endblock %}
{% block og_image %}{{ absolute_url(asset('images/gc-bernissart_agenda_cover_image.webp')) }}{% endblock %}
{% block og_url %}{{ app.request.uri }}{% endblock %}
{% block twitter_title %}{{ facebookEvent.title }} | Agenda des Gais Carabiniers{% endblock %}
{% block twitter_description %}{{ eventDescription }}{% endblock %}
{% block twitter_image %}{{ absolute_url(asset('images/gc-bernissart_agenda_cover_image.webp')) }}{% endblock %}
{% block json_ld %}
    <script type="application/ld+json">
        {{ {
            '@context': 'https://schema.org',
            '@type': 'Event',
            'name': facebookEvent.title,
            'description': facebookEvent.description|striptags,
            'startDate': facebookEvent.date|date('c'),
            'endDate': facebookEvent.date|date('c'),
            'eventStatus': 'https://schema.org/EventScheduled',
            'image': absolute_url(asset('images/gc-bernissart_agenda_cover_image.webp')),
            'organizer': {
                '@type': 'Organization',
                'name': 'Les Gais Carabiniers de Bernissart',
                'url': url('app_home')
            },
            'offers': {
                '@type': 'Offer',
                'url': app.request.uri,
                'availability': 'https://schema.org/InStock'
            },
            'url': app.request.uri
        }|json_encode(constant('JSON_HEX_TAG'))|raw }}
    </script>
{% endblock %}

{% block page_breadcrumb %}
    <ol class="flex flex-wrap items-center gap-2 text-sm text-base-content/65">
        <li>
            <a href="{{ path('app_home') }}" class="transition-colors hover:text-primary">Accueil</a>
        </li>
        <li class="text-base-content/30" aria-hidden="true">›</li>
        <li>
            <a href="{{ path('app_category_show', {'slug': 'competitions-tir-sportif'}) }}" class="transition-colors hover:text-primary">
                Compétitions de tir sportif
            </a>
        </li>
        <li class="text-base-content/30" aria-hidden="true">›</li>
        <li>
            <a href="{{ path('app_agenda') }}" class="transition-colors hover:text-primary">Agenda</a>
        </li>
        <li class="text-base-content/30" aria-hidden="true">›</li>
        <li aria-current="page" class="font-semibold tracking-[0.08em] text-base-content/95">{{ facebookEvent.title }}</li>
    </ol>
{% endblock %}

{% block page_title %}{{ facebookEvent.title }}{% endblock %}

{% block page_meta %}
    <time datetime="{{ facebookEvent.date|date('Y-m-d') }}" class="text-sm font-semibold uppercase tracking-[0.14em] text-primary">
        {{ facebookEvent.date|format_date(locale='fr', pattern='dd MMMM yyyy') }}
    </time>
{% endblock %}

{% block page_content %}
    {{ facebookEvent.description|raw }}
{% endblock %}

{% block page_aside_content %}
    {% if facebookEvent.facebookLink or (globalInfos and globalInfos.email) %}
        <section class="rounded-box border border-base-300 bg-base-200 p-6 md:p-8" aria-labelledby="event-contact-title">
            {% if facebookEvent.facebookLink %}
            <p id="event-contact-title" class="mt-0 text-2xl font-bold text-base-content">En savoir plus</p>
            <p class="mt-3 text-base-content/75">Retrouvez les informations et les échanges liés à cet événement sur Facebook.</p>
            <a href="{{ facebookEvent.facebookLink }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary  mt-6">
                Voir l'événement sur Facebook
            </a>
            {% else %}
            <p id="event-contact-title" class="mt-0 text-2xl font-bold text-base-content">Une question sur cet événement ?</p>
            <p class="mt-3 text-base-content/75">Contactez-nous pour obtenir plus d'informations.</p>
            <a href="mailto:{{ globalInfos.email }}?subject={{ facebookEvent.title|url_encode }}" class="btn btn-primary mt-6">
                Nous contacter
            </a>
            {% endif %}
        </section>
    {% endif %}
{% endblock %}
