{% extends 'base.html.twig' %}
{# {% block title %}{% trans %}club.about {% endtrans %}{% endblock %} #}
{% block title %}Histoire des Gais Carabiniers - Club de Tir à Bernissart depuis 1947{% endblock %}
{% block seo_content %}club tir Bernissart, Gais Carabiniers, tir sportif, Critérium Daniel Manfroid, URSTB-F, histoire club tir{% endblock %}
{% block seo_description %}Découvrez l'histoire des Gais Carabiniers, club de tir emblématique de Bernissart depuis 1947. Infrastructures modernes, événements comme le Critérium Daniel Manfroid et ambiance conviviale vous attendent.{% endblock %}
{% block og_title %}Histoire des Gais Carabiniers - Club de Tir à Bernissart depuis 1947{% endblock %}
{% block og_description %}Découvrez l'histoire des Gais Carabiniers, club de tir emblématique de Bernissart depuis 1947. Rejoignez une communauté passionnée dans un cadre sécurisé.{% endblock %}
{% block og_image %}https://gc-bernissart.be/images/carousel/gais-carabiniers-slider_01.jpg{% endblock %}
{% block og_url %}https://gc-bernissart.be/notre-histoire{% endblock %}
{% block twitter_title %}Histoire des Gais Carabiniers - Club de Tir à Bernissart depuis 1947{% endblock %}
{% block twitter_description %}Découvrez l'histoire des Gais Carabiniers, club de tir emblématique de Bernissart depuis 1947. Rejoignez une communauté passionnée dans un cadre sécurisé.{% endblock %}
{% block twitter_image %}https://gc-bernissart.be/images/carousel/gais-carabiniers-slider_01.jpg{% endblock %}
{% block body %}

    <!-- Introduction -->
    <div class="bg-surface-light/90 dark:bg-surface-dark/40 dark:text-content-dark/70 py-8 px-4 sm:px-16 lg:py-16 lg:px-48 space-y-16">
        <section id="introduction" class="py-8">
            <twig:Title:H1 class="text-left">Agenda</twig:Title:H1>
            <p class="leading-loose text-left">Découvrez tous les événements à venir de notre club et ne manquez aucun
                rendez-vous
                important.</p>
        </section>


        <section id="events-futur" class="py-8">
            <twig:Title:H2>{{ 'event.future' | trans }}</twig:Title:H2>
            <div class="pl-4">
                {% for item in facebook_events %}
                    <twig:Title:H3 class="space-x-8">
                        {{ item.date |format_date(locale='fr', pattern='dd MMMM yyyy') }} {{ item.title }}
                    </twig:Title:H3>
                {% else %}
                    <p class="italic">Pas encore d'événement à venir</p>
                {% endfor %}
            </div>

        </section>

        <section id="events-past" class="py-8 opacity-80">
            <twig:Title:H2>{{ 'event.past' | trans }}</twig:Title:H2>
            <div class="pl-4">
                {% for item in facebookEventsPast %}
                    <twig:Title:H3 class="space-x-8">
                        {{ item.date |format_date(locale='fr', pattern='MMMM Y') }} {{ item.title }}
                    </twig:Title:H3>
                {% else %}
                    <p class="italic">Pas d'événements passés.</p>
                {% endfor %}
            </div>
        </section>

    </div>
{% endblock %}

