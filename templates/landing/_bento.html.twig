<section>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 {# bg-secondary/90 dark:bg-secondary/30 #} p-4 rounded-2xl">

        <!-- Édito du Président -->
        <div class="bento-card md:col-span-2 bg-surface-light dark:bg-surface-dark rounded-2xl p-6 shadow-lg border  border-surface-light/50 dark:border-surface-dark/50">
            <div class="flex items-center gap-3 mb-4">
                {#                <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0"> #}
                {#                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"> #}
                {#                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path> #}
                {#                    </svg> #}
                {#                </div> #}
                <div>
                    <h3 class="text-lg font-bold text-content-primary-light dark:text-content-primary-dark/90">{{ edito.title }}</h3>
                    {#                    <p class="text-gray-500 text-sm">Jean Dupont</p> #}
                </div>
            </div>

            <p class="leading-relaxed text-content-primary-light dark:text-content-primary-dark/70">
                {{ edito.firstParagraph[0]|raw }}
            </p>
            <p class="leading-relaxed text-content-primary-light dark:text-content-primary-dark/70">
                {{ edito.firstParagraph[1]|raw }}
            </p>

            <a href="#"
               class="inline-flex items-center gap-1 text-secondary hover:text-secondary/70 font-medium mt-4 text-sm">
                Lire l'édito complet
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
            </a>
        </div>

        <!-- Photo -->
        <div class="bento-card md:col-span-2 md:row-span-2 rounded-2xl overflow-hidden relative">
            <img src="{{ asset('images/carousel/nadia_gcb.jpg') }}"
                 alt="Équipe du club"
                 class="w-full h-full object-cover">
            <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-4 py-2 rounded-full">
                <p class="text-sm font-semibold text-gray-900">📸 Instagram</p>
                {#                <p class="text-sm font-semibold text-gray-900">📸 Galerie</p> #}
            </div>
        </div>

        <!-- Prochain Événement - Priority on mobile -->
        <div {{ stimulus_controller('event-timer', {startTime: facebookEvent.date|date('c')}) }}
                class="bento-card md:col-span-2 bg-gradient-to-br from-content-primary-light/20 to-content-secondary/50 rounded-2xl p-6 text-white">
            <div class="flex items-start justify-between mb-4">
                <h3 class="text-2xl font-bold max-w-sm">Prochain tir</h3>
                <span class="bg-white/20 px-3 py-1 rounded-full text-sm font-medium">
                    {% set now = date() %}
                    {% set diff = now.diff(facebookEvent.date) %}
                    {% if facebookEvent.date < now %}
                        {# Événement passé #}
                        Il y a {{ diff.days }} jours
                    {% elseif diff.days == 0 %}
                        Aujourd\'hui !
                    {% elseif diff.days == 1 %}
                        Demain
                    {% else %}
                        Dans {{ diff.days }} jours
                    {% endif %}
                </span>
            </div>
            <div class="space-y-4">
                <div>
                    <p class="text-3xl font-bold mb-2">
                        <a href="{{ path('app_agenda_show', {slug: facebookEvent.slug}) }}"
                           class="hover:underline">{{ facebookEvent.title }}</a>
                    </p>
                    <p class="text-white/90" {{ stimulus_target('event-timer', 'output') }}></p>
                </div>
                <div class="grid grid-cols-2 gap-4 text-sm">
                    <div class="bg-white/10 rounded-lg p-3 backdrop-blur-sm">
                        <p class="text-white/70 text-xs mb-1">Date</p>
                        <p class="font-semibold">{{ facebookEvent.date|format_date('long', locale='fr') }}</p>
                    </div>
                    <div class="bg-white/10 rounded-lg p-3 backdrop-blur-sm">
                        <p class="text-white/70 text-xs mb-1">Heure</p>
                        <p class="font-semibold">{{ facebookEvent.date|date('H:i') }}</p>
                    </div>
                </div>

                {#                <button class="w-full bg-white text-orange-600 hover:bg-orange-50 px-4 py-3 rounded-lg font-semibold transition"> #}
                {% if facebookEvent.facebookLink is not null %}
                    <twig:Button:Primary class="w-full" href="{{ facebookEvent.facebookLink }}" >
                        {{ ux_icon('flowbite:thumbs-up-outline', {class: 'w-4 mr-4'}) }} Intéressé
                    </twig:Button:Primary>
                {% endif %}
                {#            </div> #}
            </div>

        </div>
</section>