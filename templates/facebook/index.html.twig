{% extends 'base.html.twig' %}

{% block title %}Agenda des événements – Gais Carabiniers de Bernissart | Compétitions & Activités{% endblock %}
{% block seo_content %}agenda, événements, compétitions, tir sportif, club de tir, Gais Carabiniers, Bernissart, activités, calendrier, concours de tir, entraînement, rencontres, URSTB-F{% endblock %}
{% block seo_description %}Consultez l’agenda des événements des Gais Carabiniers de Bernissart : compétitions, entraînements et rencontres de tir sportif. Restez informé des prochaines dates !{% endblock %}
{% block og_title %}Découvrez les événements du club de tir – Gais Carabiniers de Bernissart{% endblock %}
{% block og_description %}Ne manquez aucun événement du club de tir des Gais Carabiniers de Bernissart ! Découvrez les compétitions et activités à venir.{% endblock %}
{% block og_image %}https://gc-bernissart.be/images/gc-bernissart_agenda_cover_image.webp{% endblock %}
{% block og_url %}https://gc-bernissart.be/agenda{% endblock %}
{% block twitter_title %}Agenda des Gais Carabiniers : entraînements et compétitions{% endblock %}
{% block twitter_description %}Découvrez les événements du club de tir : compétitions, entraînements et rencontres. Ne manquez aucune date importante !{% endblock %}
{% block twitter_image %}https://gc-bernissart.be/images/gc-bernissart_agenda_cover_image.webp{% endblock %}
{% block body %}


    <section
            class="bg-surface-light/90 dark:bg-surface-dark/40 dark:text-content-primary-dark/70 py-8 px-4 sm:px-16 lg:py-16 lg:px-48 space-y-16 antialiased">
        <div class="max-w-screen-xl px-4 py-8 mx-auto lg:px-6 sm:py-16 lg:py-24">
            <div class="max-w-3xl mx-auto text-left">
                <twig:Title:H1>Agenda</twig:Title:H1>
                <twig:Title:H2 class="mt-4">
                    Voici la liste des événements à venir de notre club et ne manquez aucun rendez-vous.
                </twig:Title:H2>
                <p><a href="{{ asset('calendrier-gc-bernissart_2026.pdf') }}" class="underline">Telecharger le calendrier</a></p>
            </div>

            <div class="flow-root max-w-3xl mx-auto mt-8 sm:mt-12 lg:mt-16">
                <div class="-my-4 border-y border-content-primary-light/30 dark:border-content-primary-dark/70">
                    {% for item in facebook_events %}
                        <div class="flex flex-col gap-2 py-4 sm:gap-6 sm:flex-row sm:items-center">
                            <p class="w-32 text-lg font-normal text-content-primary-light-60 sm:text-right dark:text-content-primary-dark/60 shrink-0">
                                {{ item.date |format_date(locale='fr', pattern='dd MMMM yyyy') }}
                            </p>

                            <twig:Title:H3 class="font-semibold text-content-primary-light/90 text-content-primary-dark/90 !m-0">
                                {#                            <h3 class="text-lg font-semibold text-content-primary-light/90 text-content-primary-dark/90"> #}
                                <a href="{{ path('app_agenda_show', {'slug': item.slug}) }}" class="hover:underline">
                                    {{ item.title }}
                                </a>
                            </twig:Title:H3>
                            {#                            </h3> #}
                        </div>
                    {% else %}
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                            Aucun évènements
                        </h3>
                    {% endfor %}
                </div>
            </div>
            <div id="events-past" class="py-8 opacity-80">
                <twig:Title:H2>{{ 'event.past' | trans }}</twig:Title:H2>
                <div class="pl-4">
                    {% for item in facebookEventsPast %}
                        <twig:Title:H3 class="space-x-8">
                            <a href="{{ path('app_agenda_show', {'slug': item.slug}) }}" class="hover:underline">
                            {{ item.date |format_date(locale='fr', pattern='MMMM Y') }} {{ item.title }}
                            </a>
                        </twig:Title:H3>
                    {% else %}
                        <p class="italic">Pas d'événements passés.</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>


{% endblock %}

