{% extends 'base.html.twig' %}

{% block title %}{% trans %}faq.edit{% endtrans %}{% endblock %}

{% block body %}
    <div class="w-full lg:w-2/3 m-auto p-4">
        <h1 class="mb-8 text-2xl font-extrabold leading-none tracking-tight text-base-content md:text-3xl lg:text-4xl dark:text-base-content/70">
            {% trans %}faq.edit{% endtrans %}
        </h1>
        <div class="my-8">
            {{ include('admin/faq/_form.html.twig', {'button_label': 'button.update'}) }}
        </div>

        <a href="{{ path('admin_faq_index') }}" class="py-2.5 px-5 me-2 text-sm font-medium text-base-content/70 focus:outline-none bg-base-100 rounded-lg border border-base-300 hover:bg-base-200 hover:text-base-content focus:z-10 focus:ring-4 focus:ring-base-300">
            {% trans %}button.back_list{% endtrans %}
        </a>
    </div>
{% endblock %}
