{% if status.value == 'closed' %}
    <a href="{{ path('admin_meeting_show', {id: id}) }}"
       class="inline-flex items-center rounded-lg bg-primary px-3 py-2 text-sm font-medium text-primary-content hover:bg-primary/90 focus:outline-none focus:ring-4 focus:ring-primary/30">
        <svg class="w-4 h-4 mr-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
             fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                  stroke-width="2" d="M12 5h.01M12 12h.01M12 19h.01"/>
        </svg>
        {{ 'meeting.action.view'|trans }}
    </a>
{% else %}
<button id="dropdownActionsButton-{{ this.uid }}"
        data-dropdown-toggle="dropdownActions-{{ this.uid }}" type="button"
        class="inline-flex items-center rounded-lg bg-primary px-3 py-2 text-sm font-medium text-primary-content hover:bg-primary/90 focus:outline-none focus:ring-4 focus:ring-primary/30">
    <svg class="w-4 h-4 mr-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
         fill="none" viewBox="0 0 24 24">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
              stroke-width="2" d="M12 5h.01M12 12h.01M12 19h.01"/>
    </svg>
    {{ 'meeting.action.header'|trans }}
    <svg class="w-2.5 h-2.5 ml-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
         fill="none" viewBox="0 0 10 6">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
              stroke-width="2" d="m1 1 4 4 4-4"/>
    </svg>
</button>

<div id="dropdownActions-{{ this.uid }}"
     class="absolute z-20 hidden w-44 divide-y divide-gray-100 rounded-lg bg-white shadow dark:divide-gray-600 dark:bg-gray-700">
    <ul class="py-2 text-sm text-gray-700 dark:text-gray-200"
        aria-labelledby="dropdownActionsButton-{{ this.uid }}">
        <li>
            <a href="{{ path('admin_meeting_show', {id: id}) }}"
               class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">
                {{ 'meeting.action.view'|trans }}
            </a>
        </li>
        <li>
            <a href="{{ path('admin_meeting_add_participant', {id: id}) }}"
               class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">
                {{ 'meeting.action.add_participants'|trans }}
            </a>
        </li>
    </ul>
</div>
{% endif %}
