{% extends 'base.html.twig' %}

{% block title %}Saisie du tir{% endblock %}

{% block body %}
  <div class="container mx-auto p-4">
    <twig:Title:H1 class="text-2xl font-bold mb-4">{% if meeting.label is defined %}{{ meeting.label }}{% endif %}</twig:Title:H1>

      <twig:Title:H2>
        Tireur {{ participant.position }}:
        {% if participant.shooter is defined and participant.shooter %}
          {{ participant.shooter }}
        {% else %}
          Inconnu
        {% endif %}
      </twig:Title:H2>


    {{ form_start(form) }}
      {{ form_errors(form) }}
      <div class="my-8 flex flex-col">
        {{ form_label(form.score) }}
        {{ form_widget(form.score, { attr: {
            class: "w-20"
        }}) }}
      </div>
      <button type="submit" class="text-primary-content bg-primary/90 hover:bg-primary/90 focus:outline-none focus:ring-4 focus:ring-primary/30 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-primary/70 dark:hover:bg-primary/80 dark:focus:ring-primary/90">Valider le tir</button>
    {{ form_end(form) }}

    <div class="mt-4">
      <a class="text-blue-600 underline" href="{{ path('meeting_show', {id: meeting.id}) }}">Retour à la rencontre</a>
    </div>
  </div>
{% endblock %}

