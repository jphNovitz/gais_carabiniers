{% extends '_layout/meeting_html.twig' %}

{% macro standing_table(title, rows, markSupported) %}
    {% if rows is not empty %}
        <h2 class="mb-5 mt-0 text-3xl font-black uppercase tracking-normal text-base-content">
            {{ title }}
        </h2>

        <div class="overflow-hidden rounded-box bg-base-100 shadow-[0_1px_3px_rgba(0,0,0,0.06),0_8px_28px_rgba(0,0,0,0.07)]">
            <div class="grid grid-cols-[48px_1fr_82px] items-center gap-2 border-b border-base-300 bg-base-100 px-4 py-3 text-[10px] font-bold uppercase tracking-[0.12em] text-neutral md:grid-cols-[64px_1fr_120px] md:px-6">
                <span>{{ 'meeting.rank'|trans }}</span>
                <span>{{ 'meeting.participant'|trans }}</span>
                <span class="text-right">{{ 'meeting.points'|trans }}</span>
            </div>

            {% set prevPosition = null %}
            {% for row in rows %}
                {% set line = row.line %}
                {% set isRepeatedRank = row.rank == prevPosition %}
                <div class="grid grid-cols-[48px_1fr_82px] items-center gap-2 border-b border-base-200 px-4 py-3 last:border-b-0 md:grid-cols-[64px_1fr_120px] md:px-6
                    {% if row.rank == 1 %} bg-warning/10 shadow-[inset_3px_0_0_var(--color-warning)]
                    {% elseif row.rank == 2 %} bg-[#8E9298]/10 shadow-[inset_3px_0_0_#8E9298]
                    {% elseif row.rank == 3 %} bg-[#9A6543]/10 shadow-[inset_3px_0_0_#9A6543]
                    {% endif %}">
                    <div class="flex items-center">
                        {% if not isRepeatedRank %}
                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-black leading-none
                                {% if row.rank == 1 %} border-2 border-[#B88E10] bg-warning text-warning-content
                                {% elseif row.rank == 2 %} border-2 border-[#767A80] bg-[#8E9298] text-white
                                {% elseif row.rank == 3 %} border-2 border-[#7E5235] bg-[#9A6543] text-white
                                {% else %} bg-base-200 text-neutral {% endif %}">
                                {{ row.rank }}
                            </span>
                        {% endif %}
                        {% set prevPosition = row.rank %}
                    </div>
                    <span class="min-w-0 truncate text-sm font-semibold text-base-content md:text-[15px]">
                        {{ line.participant.firstName }} {{ line.participant.lastName|first }}.{% if markSupported and line.usesSupport %} *{% endif %}
                    </span>
                    <span class="text-right text-2xl font-black leading-none text-base-content md:text-[26px]">
                        {{ line.score }}
                    </span>
                </div>
            {% endfor %}
        </div>

        {% if markSupported %}
            <p class="mt-3 text-xs tracking-wide text-neutral">* Tir réalisé avec appui</p>
        {% endif %}
    {% endif %}
{% endmacro %}

{% block nav_secondary %}{% endblock %}

{% block content %}
    {% import _self as standingMacros %}
    <main class="mx-auto max-w-[980px] px-4 pb-20 md:px-8">
        {% if categorizedStanding is defined and (categorizedStanding.standard is not empty or categorizedStanding.supported is not empty or categorizedStanding.overall is not empty) %}
            <div class="mb-8 border-b border-base-300">
                <ul class="-mb-px flex overflow-x-auto"
                    id="default-tab"
                    data-tabs-toggle="#default-tab-content"
                    data-tabs-active-classes="text-base-content border-primary font-bold"
                    data-tabs-inactive-classes="text-neutral border-transparent font-semibold hover:text-base-content"
                    role="tablist">
                    <li class="me-2" role="presentation">
                        <button
                                class="inline-block border-b-2 px-5 py-[18px] pb-3.5 text-sm transition-colors duration-200"
                                id="overall-tab"
                                data-tabs-target="#overall"
                                type="button"
                                role="tab"
                                aria-controls="overall"
                                aria-selected="false">
                            {{ 'meeting.tab.overall' |trans }}
                        </button>
                    </li>
                    <li class="me-2" role="presentation">
                        <button
                                class="inline-block border-b-2 px-5 py-[18px] pb-3.5 text-sm transition-colors duration-200"
                                id="standard-tab"
                                data-tabs-target="#standard"
                                type="button"
                                role="tab"
                                aria-controls="standard"
                                aria-selected="false">
                            {{ 'meeting.tab.standard' |trans }}
                        </button>
                    </li>
                    <li class="me-2" role="presentation">
                        <button
                                class="inline-block border-b-2 px-5 py-[18px] pb-3.5 text-sm transition-colors duration-200"
                                id="supported-tab"
                                data-tabs-target="#supported"
                                type="button"
                                role="tab"
                                aria-controls="supported"
                                aria-selected="true">
                            {{ 'meeting.tab.supported' |trans }}
                        </button>
                    </li>
                </ul>
            </div>
            <div id="default-tab-content">
                <div
                        class="hidden"
                        id="overall"
                        role="tabpanel"
                        aria-labelledby="overall-tab">
                    {{ standingMacros.standing_table('Tir plaquettes général', categorizedStanding.overall, true) }}
                </div>
                <div
                        class="hidden"
                        id="standard"
                        role="tabpanel"
                        aria-labelledby="standard-tab">
                    {{ standingMacros.standing_table('Tir plaquettes standard', categorizedStanding.standard, false) }}
                </div>
                <div
                        class=""
                        id="supported"
                        role="tabpanel"
                        aria-labelledby="supported-tab">
                    {{ standingMacros.standing_table('Tir plaquettes appuyé', categorizedStanding.supported, true) }}
                </div>
            </div>
        {% else %}
            <p class="rounded-box bg-base-200 p-6 text-base-content">Aucun participant n'a encore été ajouté.</p>
        {% endif %}
    </main>
{% endblock %}
