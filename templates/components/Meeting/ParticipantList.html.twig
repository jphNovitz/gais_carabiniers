{% set meeting = this.meeting %}
{% set participants = this.participants %}

<div{{ attributes }}>
    {% if participants is defined and participants|length > 0 %}
        <div class="table-responsive">
            <table class="table table-sm table-hover table-bordered align-middle">
                <thead class="table-light">
                <tr>
                    <th scope="col" class="text-uppercase small">Position</th>
                    <th scope="col"></th>
                    <th scope="col" class="text-uppercase small">Participant</th>
                    <th scope="col" class="text-uppercase small">Présent</th>
                </tr>
                </thead>
                <tbody>
                {% for p in participants %}
                    <tr>
                        <td class="small w-auto">{{ p.position }}</td>
                        <td class="small" style="width: 60px">
                            <button type="button"
                                    class="btn btn-link btn-sm p-0 text-body"
                                    data-action="live#action"
                                    data-live-id-param="{{ p.id }}"
                                    data-live-action-param="moveUp">
                                <i class="fas fa-caret-up"></i>
                            </button>
                            <button type="button"
                                    class="btn btn-link btn-sm p-0 text-body"
                                    data-action="live#action"
                                    data-live-id-param="{{ p.id }}"
                                    data-live-action-param="moveDown">
                                <i class="fas fa-caret-down"></i>
                            </button>
                        </td>
                        <td class="small">{{ p.firstName }} {{ p.lastName }}</td>
                        <td class="small">
                            {% if p.present %}
                                <span class="badge text-bg-success">Oui</span>
                            {% else %}
                                <span class="badge text-bg-danger">Non</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="text-content-primary-light dark:text-content-primary-dark">
            Aucun participant n'a encore été ajouté.
        </p>
    {% endif %}
</div>
