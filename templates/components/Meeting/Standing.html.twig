<div{{ attributes }}>

    <select data-model="year" class="mb-4 p-2 border border-base-light rounded bg-surface-light text-content-primary-light dark:bg-surface-dark dark:text-content-primary-dark dark:border-base-dark">
        {% for availableYear in this.availableYears %}
            <option value="{{ availableYear }}"
                    {% if availableYear == year %}selected{% endif %}>
                {{ availableYear }}
            </option>
        {% endfor %}
    </select>

    {% if this.standings is not empty %}
        <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
            <table class="table-auto w-full text-sm text-left rtl:text-right text-content-primary-light dark:text-content-primary-dark">
                <thead class="text-xs uppercase bg-surface-light dark:bg-surface-dark text-content-primary-light dark:text-content-primary-dark bg-opacity-90">
                <tr>
                    <th scope="col" class="px-3 py-3">#</th>
                    <th scope="col" class="px-3 py-3"> </th>
                    <th scope="col" class="px-3 py-3 whitespace-nowrap">Participant</th>
                    <th scope="col" class="px-3 py-3 text-center whitespace-nowrap">
                        <span class="block md:hidden">Part.</span>
                        <span class="hidden md:block">Participations</span>
                    </th>
                    <th scope="col" class="px-3 py-3 text-center whitespace-nowrap">
                        <span class="block md:hidden">Plaq.</span>
                        <span class="hidden md:block"> {{ 'meeting.points' |trans }}</span>
                    </th>
                    <th scope="col" class="px-3 py-3 text-center whitespace-nowrap">
                        <span class="block md:hidden"> {{ 'meeting.avgHits_min' |trans }} </span>
                        <span class="hidden md:block"> {{ 'meeting.avgHits' |trans }} </span>
                    </th>
                </tr>
                </thead>
                <tbody>
                {% set prevMeetingPosition = null %}
                {% for row in this.standings %}
                    <tr class="bg-surface-light border-b border-base-light dark:bg-surface-dark dark:border-base-dark hover:bg-base-light dark:hover:bg-base-dark">
                        <td class="px-3 py-4 font-medium text-content-primary-light whitespace-nowrap dark:text-content-primary-dark">
                            {% if row.rank != prevMeetingPosition %}
                                {{ row.rank }}
                            {% endif %}
                            {% set prevMeetingPosition = row.rank %}
                        </td>
                        <td class="p-3">
                            {% set change = row.previousRank is not null and row.previousRank > 0 ? row.previousRank - row.rank : null %}

                            {% if change is null %}
                                <span class="">-</span>
                            {% elseif change > 0 %}
                                <span class="text-green-900 fw-bold">↗ +{{ change }}</span>
                            {% elseif change < 0 %}
                                <span class="text-red-900 fw-bold">↘ {{ change }}</span>
                            {% else %}
                                <span class="text-muted">→ =</span>
                            {% endif %}
                        </td>
                        <td class="px-3 py-4 whitespace-nowrap">

                            {{ row.firstName }} {{ row.lastName|first }}.
                            {% if row.usesSupport is defined and row.usesSupport %}
                                <span class="text-xs">*</span>
                            {% endif %}
                        </td>
                        <td class="px-3 py-4 text-center text-content-primary-light dark:text-content-primary-dark">{{ row.meetingCount }}</td>
                        <td class="px-3 py-4 text-center text-content-primary-light dark:text-content-primary-dark">{{ row.totalScore }}</td>
                        <td class="px-3 py-4 text-center text-content-primary-light dark:text-content-primary-dark">{{ row.averageHits }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            <div class="mt-2 text-xs text-content-secondary-light dark:text-content-secondary-dark">
                <p class="md:hidden">Plaq. : nombre de plaquettes abattues<br>Part. : nombre de participations</p>
                <p>* Tir réalisé avec appui</p>
            </div>
        </div>
    {% else %}
        <div class="p-4 text-sm text-content-primary-light bg-surface-light border border-surface-light rounded-lg dark:bg-surface-dark dark:text-content-primary-dark dark:border-surface-dark">
            Aucun classement disponible pour le moment.
        </div>
    {% endif %}
</div>